using Intergraph.MFR.ApprovalsCommandModule;

public class AttachmentsRequestHandlerTests
{
    private readonly Mock<ILogger> _mockLogger = new();
    private readonly Mock<ILocalizedStrings> _mockLocalized = new();
    private readonly Mock<ISession> _mockSession = new();
    private readonly Mock<IParameterAccess> _mockParameterAccess = new();

    // Helper: create handler instance and inject a mocked MFRDataAccess into private field _afrDataAccess
    private AttachmentsRequestHandler CreateHandlerAndInjectDataAccess(out Mock<MFRDataAccess> mockDataAccess)
    {
        var handler = new AttachmentsRequestHandler(
            _mockLogger.Object,
            _mockLocalized.Object,
            _mockSession.Object,
            _mockParameterAccess.Object);

        mockDataAccess = new Mock<MFRDataAccess>(_mockParameterAccess.Object, _mockLogger.Object) { CallBase = false };

        // Set up default behaviour to avoid nulls
        mockDataAccess.Setup(m => m.GetAttachmentCopyStatusByReferenceId(It.IsAny<string>()))
                      .Returns((ATTACHMENTS_COPY_STATUS)null);

        // Replace private readonly field _afrDataAccess using reflection
        var field = typeof(AttachmentsRequestHandler)
            .GetField("_afrDataAccess", BindingFlags.Instance | BindingFlags.NonPublic);

        Assert.NotNull(field); // to surface mismatch early
        field.SetValue(handler, mockDataAccess.Object);

        return handler;
    }

    private CreateAttachmentRequest BuildAddRequest(string chunkDir)
    {
        var attachmentDto = new AttachmentDto
        {
            AttachmentId = Guid.NewGuid().ToString(),
            RequestType = AttachmentActions.AddAttachment,
            Recnum = null,
            FilePath = chunkDir,
            ContentSize = 0,
            FormType = "REPORT",
            FormRecnum = "123",
            CreatedBy = "user1"
        };

        return new CreateAttachmentRequest { Attachment = attachmentDto };
    }

    [Fact(DisplayName = "AddAttachment - happy path creates attachment and copies file")]
    public void AddAttachment_HappyPath_CreatesAndCopiesFile()
    {
        // Arrange - prepare chunk directory with a single chunk file
        string chunkDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(chunkDir);
        string chunkFile = Path.Combine(chunkDir, "1");
        File.WriteAllBytes(chunkFile, new byte[] { 1, 2, 3 });

        // repository destination path where MoveFileToOCRSharedPath will place final file
        string repoDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(repoDir);

        // parameter access returns values used by FileCheck.GetFilePathWithGuid and GetFullPathName
        _mockParameterAccess.Setup(p => p.GetParameterListItem("MFR", "Repository", "AfrCombinedChunksRepositoryLocation"))
                            .Returns(chunkDir);
        _mockParameterAccess.Setup(p => p.GetParameterListItem("MFR", "Repository", "AfrAttachmentRepositoryLocation"))
                            .Returns(repoDir);

        // Setup data access to return a simple ATTACHMENT record when CreateNewAttachment called
        var handler = CreateHandlerAndInjectDataAccess(out var mockDataAccess);

        var fakeAttachmentRecord = new ATTACHMENT { CUSTOM_DATA = "orig" };
        mockDataAccess.Setup(m => m.CreateNewAttachment(It.IsAny<AttachmentDto>()))
                      .Returns(fakeAttachmentRecord);

        // Build request
        var req = BuildAddRequest(chunkDir);

        // Act
        var resp = handler.HandleMessage(new MessageHeader { SessionId = "session1" }, req);

        // Assert
        Assert.True(resp.Response.Success);
        var createResp = resp.Result as CreateAttachmentResponse;
        Assert.NotNull(createResp);
        Assert.True(createResp.IsSuccess);
        // attachment record should be added to CustomData dictionary inside response (handler puts it in CustomData)
        Assert.True(createResp.CustomData != null);
        // The handler should have attempted to create the file in the repo path
        // The repository target file path is derived from FileCheck.GetFullPathName; we assert repo dir exists and contains a file
        Assert.True(Directory.Exists(repoDir));
        var filesInRepo = Directory.GetFiles(repoDir);
        Assert.True(filesInRepo.Length >= 1);

        // cleanup
        Directory.Delete(chunkDir, true);
        Directory.Delete(repoDir, true);
    }

    [Fact(DisplayName = "AddAttachment - chunk directory empty still returns success")]
    public void AddAttachment_EmptyChunksDirectory_Succeeds()
    {
        // Arrange
        string chunkDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(chunkDir); // no files inside

        string repoDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(repoDir);

        _mockParameterAccess.Setup(p => p.GetParameterListItem("MFR", "Repository", "AfrCombinedChunksRepositoryLocation"))
                            .Returns(chunkDir);
        _mockParameterAccess.Setup(p => p.GetParameterListItem("MFR", "Repository", "AfrAttachmentRepositoryLocation"))
                            .Returns(repoDir);

        var handler = CreateHandlerAndInjectDataAccess(out var mockDataAccess);

        mockDataAccess.Setup(m => m.CreateNewAttachment(It.IsAny<AttachmentDto>()))
                      .Returns(new ATTACHMENT());

        var req = BuildAddRequest(chunkDir);

        // Act
        var resp = handler.HandleMessage(new MessageHeader { SessionId = "s2" }, req);

        // Assert
        Assert.True(resp.Response.Success);
        var createResp = resp.Result as CreateAttachmentResponse;
        Assert.True(createResp.IsSuccess);

        // cleanup
        Directory.Delete(chunkDir, true);
        Directory.Delete(repoDir, true);
    }

    [Fact(DisplayName = "MoveFileToOCRSharedPath - copies file when destination missing")]
    public void MoveFileToOCRSharedPath_CopiesFile()
    {
        // This test goes through AddAttachment which calls MoveFileToOCRSharedPath internally.
        string chunkDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(chunkDir);
        File.WriteAllBytes(Path.Combine(chunkDir, "1"), new byte[] { 9, 9 });

        string repoDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(repoDir);

        _mockParameterAccess.Setup(p => p.GetParameterListItem("MFR", "Repository", "AfrCombinedChunksRepositoryLocation"))
                            .Returns(chunkDir);
        _mockParameterAccess.Setup(p => p.GetParameterListItem("MFR", "Repository", "AfrAttachmentRepositoryLocation"))
                            .Returns(repoDir);

        var handler = CreateHandlerAndInjectDataAccess(out var mockDataAccess);
        mockDataAccess.Setup(m => m.CreateNewAttachment(It.IsAny<AttachmentDto>()))
                      .Returns(new ATTACHMENT());

        var req = BuildAddRequest(chunkDir);

        var resp = handler.HandleMessage(new MessageHeader { SessionId = "s3" }, req);

        Assert.True(resp.Response.Success);
        Assert.True(resp.Result is CreateAttachmentResponse r && r.IsSuccess);
        var destFiles = Directory.GetFiles(repoDir);
        Assert.True(destFiles.Length > 0);

        Directory.Delete(chunkDir, true);
        Directory.Delete(repoDir, true);
    }

    [Fact(DisplayName = "UpdateAttachmentDeleteStatus - attachment exists and is deleted (ACK true)")]
    public void UpdateAttachmentDeleteStatus_AttachmentExists_IsDeleted()
    {
        // Arrange
        var handler = CreateHandlerAndInjectDataAccess(out var mockDataAccess);

        var attachDto = new AttachmentDto
        {
            AttachmentId = "ref-1",
            RequestType = AttachmentActions.AttachmentDeleteStatus
        };
        var req = new CreateAttachmentRequest { Attachment = attachDto };

        // Data access returns an attachment that is marked deleted
        var attachmentRecord = new ATTACHMENT { IS_DELETED = true, ACK_MESSAGE = "ACK_OK" };
        mockDataAccess.Setup(m => m.GetAttachmentByRef("ref-1")).Returns(attachmentRecord);

        // Act: call HandleMessage which will call UpdateAttachmentDeleteStatus branch
        var resp = handler.HandleMessage(new MessageHeader(), req);

        // Assert
        Assert.True(resp.Response.Success);
        var createResp = resp.Result as CreateAttachmentResponse;
        Assert.True(createResp.IsSuccess);
        Assert.Equal("ACK_OK", createResp.Message);
    }

    [Fact(DisplayName = "UpdateAttachmentDeleteStatus - attachment exists and is not deleted (ACK false)")]
    public void UpdateAttachmentDeleteStatus_AttachmentExists_NotDeleted()
    {
        var handler = CreateHandlerAndInjectDataAccess(out var mockDataAccess);

        var attachDto = new AttachmentDto
        {
            AttachmentId = "ref-2",
            RequestType = AttachmentActions.AttachmentDeleteStatus
        };
        var req = new CreateAttachmentRequest { Attachment = attachDto };

        // Data access returns an attachment that is NOT deleted
        var attachmentRecord = new ATTACHMENT { IS_DELETED = false, ACK_MESSAGE = "PENDING_ACK" };
        mockDataAccess.Setup(m => m.GetAttachmentByRef("ref-2")).Returns(attachmentRecord);

        var resp = handler.HandleMessage(new MessageHeader(), req);

        Assert.True(resp.Response.Success);
        var createResp = resp.Result as CreateAttachmentResponse;
        Assert.False(createResp.IsSuccess);
        Assert.Equal("PENDING_ACK", createResp.Message);
    }

    [Fact(DisplayName = "DeleteAttachmentFromOCR - linked recnum not provided => short-circuit")]
    public void DeleteAttachmentFromOCR_LinkedRecnumMissing_ShortCircuits()
    {
        var handler = CreateHandlerAndInjectDataAccess(out var mockDataAccess);

        // Build delete request with LinkedAttachmentRecnum empty or non-numeric
        var attachDto = new AttachmentDto
        {
            AttachmentId = "some-ref",
            RequestType = AttachmentActions.DeleteAttachment,
            LinkedAttachmentRecnum = "0", // will parse to 0 => short-circuit
            CreatedBy = "userX"
        };
        var req = new CreateAttachmentRequest { Attachment = attachDto };

        var resp = handler.HandleMessage(new MessageHeader(), req);

        // Expect success (handler sets response.Success = true) and no exception
        Assert.True(resp.Response.Success);
        var createResp = resp.Result as CreateAttachmentResponse;
        Assert.True(createResp.IsSuccess);
    }

    [Fact(DisplayName = "InsertAttachmentCopyStatus - handles Add/Update flow")]
    public void InsertAttachmentCopyStatus_AddsOrUpdatesStatus()
    {
        var handler = CreateHandlerAndInjectDataAccess(out var mockDataAccess);

        // Ensure parameter access returns a repo path used by FileCheck
        string repoDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(repoDir);
        _mockParameterAccess.Setup(p => p.GetParameterListItem("MFR", "Repository", "AfrAttachmentRepositoryLocation"))
                            .Returns(repoDir);

        var req = BuildAddRequest(repoDir);

        // The local method InsertAttachmentCopyStatus inside handler creates a NEW MFRDataAccess locally.
        // To detect this call we cannot replace that local instance easily. Instead we assert no exception and that the handler completes.
        var resp = handler.HandleMessage(new MessageHeader(), req);

        Assert.True(resp.Response.Success);

        Directory.Delete(repoDir, true);
    }

    [Fact(DisplayName = "HandleMessage - if parameterAccess throws -> response failure and logger.Critical called")]
    public void HandleMessage_ParameterAccessThrows_GracefulFailure()
    {
        // Arrange: make parameter access throw
        _mockParameterAccess.Setup(p => p.GetParameterListItem(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
                            .Throws(new Exception("param-fail"));

        var handler = CreateHandlerAndInjectDataAccess(out var mockDataAccess);

        var req = BuildAddRequest(Path.Combine(Path.GetTempPath(), "doesnt-matter"));

        // Act
        var resp = handler.HandleMessage(new MessageHeader(), req);

        // Assert
        Assert.False(resp.Response.Success);
        _mockLogger.Verify(l => l.Critical(It.IsAny<string>(), It.IsAny<Exception>()), Times.AtLeastOnce);
    }
}
