    private readonly Mock<ILocalizedStrings> _localized = new();
    private readonly Mock<ISession> _session = new();
    private readonly Mock<IParameterAccess> _parameterAccess = new();

    private ChunksRequestHandler CreateHandler() =>
        new ChunksRequestHandler(_logger.Object, _localized.Object, _session.Object, _parameterAccess.Object);

    private AFRCreateChunkRequest CreateRequest(bool isResume, string content = "AA==")
    {
        return new AFRCreateChunkRequest
        {
            ChunkDetails = new ChunkDetails
            {
                ChunkId = 1,
                ChunkContentBinary = content,
                IsResume = isResume,
                AttachmentGuid = Guid.NewGuid().ToString()
            }
        };
