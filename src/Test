    [Fact]
    public void Handle_ResumeMode_ReturnsExistingChunks()
    {
        string tempDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(tempDir);
        File.WriteAllText(Path.Combine(tempDir, "1"), "data");

        _parameterAccess.Setup(x => x.GetParameterListItem(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
            .Returns(tempDir);

        var handler = CreateHandler();
        var req = CreateRequest(isResume: true);

        var resp = handler.HandleMessage(new MessageHeader(), req);

        Assert.True(resp.Response.Success);
        Assert.Single(((AFRCreateChunkResponse)resp.Result).ChunkIds);
    }

    [Fact]
    public void Handle_UploadMode_WritesFileSuccessfully()
    {
        string tempDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(tempDir);

        _parameterAccess.Setup(x => x.GetParameterListItem(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
            .Returns(tempDir);

        var handler = CreateHandler();
        var req = CreateRequest(isResume: false);

        var resp = handler.HandleMessage(new MessageHeader(), req);

        Assert.True(resp.Response.Success);
        Assert.True(((AFRCreateChunkResponse)resp.Result).IsChunkUploaded);
    }

    [Fact]
    public void Handle_Exception_ReturnsFailure()
    {
        _parameterAccess.Setup(x => x.GetParameterListItem(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
            .Throws(new Exception("boom"));

        var handler = CreateHandler();
        var req = CreateRequest(false);

        var resp = handler.HandleMessage(new MessageHeader(), req);

        Assert.False(resp.Response.Success);
        _logger.Verify(l => l.Critical(It.IsAny<string>(), It.IsAny<Exception>()), Times.Once);
    }
}
