using Intergraph.MFR.ApprovalsModule;
using Microsoft.Extensions.Logging;
using Moq;
using System;
using System.IO;
using System.Security.AccessControl;
using System.Security.Principal;
using Xunit;

public class FileCheckTests
{
    private readonly Mock<ILogger> _loggerMock;
    private readonly FileCheck _fileCheck;

    public FileCheckTests()
    {
        _loggerMock = new Mock<ILogger>();
        _fileCheck = new FileCheck(_loggerMock.Object);
    }

    [Fact]
    public void GetFilePathWithGuid_ReturnsCorrectPath()
    {
        string repo = "/root/{0}";
        string guid = "123";

        var result = _fileCheck.GetFilePathWithGuid(repo, guid);

        Assert.Equal(Path.Combine("/root/123"), result);
    }

    [Fact]
    public void CreateUploadDirectoryIfNotExist_ThrowsForNull()
    {
        Assert.Throws<ArgumentNullException>(() => _fileCheck.CreateUploadDirectoryIfNotExist(null));
    }

    [Fact]
    public void CreateUploadDirectoryIfNotExist_CreatesDirectory()
    {
        string dir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());

        var result = _fileCheck.CreateUploadDirectoryIfNotExist(dir);

        Assert.True(Directory.Exists(dir));
        Assert.Equal(dir, result);
    }

    [Fact]
    public void GetFullPathName_ReturnsCombinedPath()
    {
        string dir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        string file = "file.txt";

        var full = _fileCheck.GetFullPathName(dir, file);

        Assert.Equal(Path.Combine(dir, file), full);
    }

    [Fact]
    public void CheckDirectoryAccess_ThrowsWhenNoWritePermission()
    {
        string dir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(dir);

        DirectorySecurity security = Directory.GetAccessControl(dir);
        SecurityIdentifier everyone = new SecurityIdentifier(WellKnownSidType.WorldSid, null);
        security.AddAccessRule(new FileSystemAccessRule(everyone, FileSystemRights.Write, AccessControlType.Deny));
        Directory.SetAccessControl(dir, security);

        Assert.Throws<InvalidOperationException>(() => _fileCheck.CheckDirecotoryAccess(dir));
    }

    [Fact]
    public void CheckDirectoryAccess_AllowsWhenNoDenyRule()
    {
        string dir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(dir);

        _fileCheck.CheckDirecotoryAccess(dir);
    }
}
