using Xunit;
using Moq;
using System;
using System.IO;
using System.Reflection;
using Intergraph.Framework.Contracts;
using Intergraph.Framework.Logging;
using Intergraph.Framework.Localization;
using Intergraph.MFR.DataAccess;
using Intergraph.MFR.DataAccess.Entities;
using Intergraph.MFR.ApprovalsModule;
using System.Collections.Generic;

public class AttachmentsRequestHandlerTests
{
    private readonly Mock<ILogger> _loggerMock = new();
    private readonly Mock<ILocalizedStrings> _localizedStringsMock = new();
    private readonly Mock<IParameterAccess> _parameterAccessMock = new();
    private readonly Mock<ISession> _sessionMock = new();

    private AttachmentsRequestHandler CreateHandler()
    {
        var handler = new AttachmentsRequestHandler(
            _loggerMock.Object,
            _localizedStringsMock.Object,
            _sessionMock.Object,
            _parameterAccessMock.Object
        );

        // Mock MFRDataAccess to avoid null references
        var mockDataAccess = new Mock<MFRDataAccess>(_parameterAccessMock.Object, _loggerMock.Object);
        var mockServiceManager = new Mock<IWebRestServiceManager>();

        // Inject mocks into private fields using reflection
        InjectPrivateField(handler, "_dataAccess", mockDataAccess.Object);
        InjectPrivateField(handler, "_serviceManager", mockServiceManager.Object);
        InjectPrivateField(handler, "_agent", "TestAgent");

        return handler;
    }

    private static void InjectPrivateField(object target, string fieldName, object value)
    {
        var field = target.GetType().GetField(fieldName,
            BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.IgnoreCase);
        if (field != null)
            field.SetValue(target, value);
    }

    [Fact]
    public void HandleMessage_Should_Handle_AddAttachment_Successfully()
    {
        var handler = CreateHandler();
        var tempDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(tempDir);

        var dummyFile = Path.Combine(tempDir, "file1.txt");
        File.WriteAllText(dummyFile, "dummy data");

        _parameterAccessMock.Setup(x =>
            x.GetParameterListItem("MFR", "Repository", "MfrCombinedChunksRepositoryLocation"))
            .Returns(tempDir);

        var request = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                AttachmentId = Guid.NewGuid().ToString(),
                RequestType = AttachmentActions.AddAttachment,
                FilePath = tempDir
            }
        };

        var result = handler.HandleMessage(new MessageHeader(), request);

        Assert.NotNull(result);
        Assert.True(result.Response.Success);
        Directory.Delete(tempDir, true);
    }

    [Fact]
    public void HandleMessage_Should_Handle_DeleteAttachment()
    {
        var handler = CreateHandler();
        var request = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                AttachmentId = "A1",
                RequestType = AttachmentActions.DeleteAttachment
            }
        };

        var result = handler.HandleMessage(new MessageHeader(), request);
        Assert.True(result.Response.Success);
    }

    [Fact]
    public void HandleMessage_Should_Handle_AttachmentDeleteStatus()
    {
        var handler = CreateHandler();
        var request = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                AttachmentId = "B1",
                RequestType = AttachmentActions.AttachmentDeleteStatus
            }
        };

        var result = handler.HandleMessage(new MessageHeader(), request);
        Assert.True(result.Response.Success);
    }

    [Fact]
    public void HandleMessage_Should_Handle_UnknownType()
    {
        var handler = CreateHandler();
        var request = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                RequestType = "RandomType"
            }
        };

        var result = handler.HandleMessage(new MessageHeader(), request);
        Assert.True(result.Response.Success);
    }

    [Fact]
    public void HandleMessage_Should_Catch_Exception()
    {
        var handler = CreateHandler();
        var result = handler.HandleMessage(new MessageHeader(), null);
        Assert.True(result.Response.Success);
        Assert.NotEmpty(result.Response.Messages);
    }

    [Fact]
    public void UpdateAttachmentDeleteStatus_Should_Handle_Success()
    {
        var handler = CreateHandler();

        var att = new ATTACHMENT { IS_DELETED = true, ACK_MESSAGE = "Deleted" };
        var dataAccessMock = new Mock<MFRDataAccess>(_parameterAccessMock.Object, _loggerMock.Object);
        dataAccessMock.Setup(x => x.GetAttachmentByRef(It.IsAny<string>())).Returns(att);

        InjectPrivateField(handler, "_dataAccess", dataAccessMock.Object);

        var request = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto { AttachmentId = "1" }
        };

        var response = new CreateAttachmentResponse();

        InvokePrivate(handler, "UpdateAttachmentDeleteStatus", request, response);

        Assert.True(response.IsSuccess);
    }

    [Fact]
    public void CheckAttachmentsFromApi_Should_Execute()
    {
        var handler = CreateHandler();

        var mockService = new Mock<IWebRestServiceManager>();
        mockService.Setup(x => x.GetAttachmentList(It.IsAny<string>(), It.IsAny<string>()))
                   .Returns("{\"result\":{\"attachments\":[]}}");
        InjectPrivateField(handler, "_serviceManager", mockService.Object);

        var request = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                FormType = "FormA",
                FormRecnum = "123",
                CreatedBy = "user"
            }
        };

        var response = new CreateAttachmentResponse();
        InvokePrivate(handler, "CheckAttachmentsFromApi", request, response);

        Assert.True(response.IsSuccess);
    }

    [Fact]
    public void UpdateAttachmentRecordStatus_Should_Not_Throw()
    {
        var handler = CreateHandler();
        var request = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                AttachmentId = "1",
                LinkedAttachmentRecnum = "10",
                AttachmentRecnum = "11"
            }
        };
        InvokePrivate(handler, "UpdateAttachmentRecordStatus", request);
    }

    [Fact]
    public void DeleteAttachmentFromOCR_Should_Run_All_Paths()
    {
        var handler = CreateHandler();
        _parameterAccessMock.Setup(x => x.GetParameterListItem(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
                            .Returns("TestValue");

        var request = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                LinkedAttachmentRecnum = "5",
                CreatedBy = "user"
            }
        };

        InvokePrivate(handler, "DeleteAttachmentFromOCR", request);
    }

    [Fact]
    public void InsertAttachmentMergeProgress_Should_Cover_All_Statuses()
    {
        var handler = CreateHandler();
        var mergeRequest = new MFRCreateMergeChunkRequest
        {
            MergeChunkDetails = new MergeChunkDetails
            {
                AttachmentGuid = Guid.NewGuid().ToString()
            }
        };

        var statuses = new[] { "Pending", "Success", "Failed", "Random" };

        foreach (var status in statuses)
        {
            InvokePrivate(handler, "InsertAttachmentMergeProgess", mergeRequest, status);
        }
    }

    private static void InvokePrivate(object instance, string methodName, params object[] args)
    {
        instance.GetType().GetMethod(methodName,
            BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.IgnoreCase)
            ?.Invoke(instance, args);
    }
}
