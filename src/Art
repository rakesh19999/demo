using Xunit;
using Moq;
using System;
using System.Collections.Generic;
using System.IO;
using Newtonsoft.Json.Linq;
using Intergraph.MFR.ApprovalsModule;
using Intergraph.Framework.Contracts;
using Intergraph.Framework.Logging;
using Intergraph.Framework.Localization;
using Intergraph.MFR.DataAccess;
using Intergraph.MFR.DataAccess.Entities;

public class AttachmentsRequestHandlerTests
{
    private readonly Mock<ILogger> _loggerMock = new();
    private readonly Mock<ILocalizedStrings> _localizedStringsMock = new();
    private readonly Mock<IParameterAccess> _parameterAccessMock = new();

    private TestableAttachmentsRequestHandler CreateHandler()
    {
        return new TestableAttachmentsRequestHandler(
            _loggerMock.Object,
            _localizedStringsMock.Object,
            null,
            _parameterAccessMock.Object
        );
    }

    [Fact]
    public void HandleMessage_ShouldAddAttachment_Success()
    {
        // Arrange
        var handler = CreateHandler();
        handler.FileCheckMock.Setup(x => x.GetFilePathWithGuid(It.IsAny<string>(), It.IsAny<string>()))
            .Returns(Path.GetTempPath());
        handler.FileCheckMock.Setup(x => x.CreateUploadDirectoryIfNotExist(It.IsAny<string>())).Returns(Path.GetTempPath());
        handler.MFRDataAccessMock.Setup(x => x.CreateNewAttachment(It.IsAny<AttachmentDto>()))
            .Returns(new ATTACHMENT { ATTACHMENT_ID = "A1", CUSTOM_DATA = "" });

        var header = new MessageHeader();
        var request = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                AttachmentId = "A1",
                RequestType = AttachmentActions.AddAttachment,
                Recnum = null,
                FilePath = Path.GetTempPath()
            }
        };

        Directory.CreateDirectory(request.Attachment.FilePath);
        File.WriteAllText(Path.Combine(request.Attachment.FilePath, "test.txt"), "dummy");

        // Act
        var result = handler.HandleMessage(header, request);

        // Assert
        Assert.True(result.Response.Success);
        Assert.True(((CreateAttachmentResponse)result.Message).IsSuccess);
    }

    [Fact]
    public void HandleMessage_ShouldDeleteAttachment_Success()
    {
        var handler = CreateHandler();
        var request = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                AttachmentId = "A1",
                RequestType = AttachmentActions.DeleteAttachment,
                LinkedAttachmentRecnum = "1"
            }
        };

        var header = new MessageHeader();
        handler.MFRDataAccessMock.Setup(x => x.GetAttachmentByRef(It.IsAny<string>()))
            .Returns(new ATTACHMENT { ATTACHMENT_ID = "A1" });

        // Act
        var result = handler.HandleMessage(header, request);

        // Assert
        Assert.True(result.Response.Success);
    }

    [Fact]
    public void HandleMessage_ShouldHandleUnknownRequestType()
    {
        var handler = CreateHandler();
        var header = new MessageHeader();
        var request = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                AttachmentId = "A1",
                RequestType = "Unknown"
            }
        };

        var result = handler.HandleMessage(header, request);

        Assert.True(result.Response.Success);
    }

    [Fact]
    public void HandleMessage_ShouldHandleException()
    {
        var handler = CreateHandler();
        handler.ThrowInInsertCopyStatus = true;
        var header = new MessageHeader();
        var request = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto { AttachmentId = "A1", RequestType = AttachmentActions.AddAttachment }
        };

        var result = handler.HandleMessage(header, request);

        Assert.True(result.Response.Success);
        Assert.Contains("Insert failed", result.Response.Messages[0]);
    }

    [Fact]
    public void UpdateAttachmentDeleteStatus_ShouldSetSuccessAndFailure()
    {
        var handler = CreateHandler();
        var response = new CreateAttachmentResponse();
        var request = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto { AttachmentId = "A1" }
        };

        handler.MFRDataAccessMock.Setup(x => x.GetAttachmentByRef("A1"))
            .Returns(new ATTACHMENT { IS_DELETED = true, ACK_MESSAGE = "done" });
        handler.InvokeUpdateAttachmentDeleteStatus(request, response);
        Assert.True(response.IsSuccess);

        handler.MFRDataAccessMock.Setup(x => x.GetAttachmentByRef("A1"))
            .Returns(new ATTACHMENT { IS_DELETED = false, ACK_MESSAGE = "pending" });
        handler.InvokeUpdateAttachmentDeleteStatus(request, response);
        Assert.False(response.IsSuccess);
    }

    [Fact]
    public void CheckAttachmentsFromApi_ShouldSetSuccessAndPending()
    {
        var handler = CreateHandler();
        var response = new CreateAttachmentResponse();
        var request = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                CreatedBy = "user",
                FormType = "A",
                FormRecnum = "R1",
                AttachmentRecnum = "R1"
            }
        };

        handler.WebRestServiceMock.Setup(x => x.GetAttachmentList(It.IsAny<string>(), It.IsAny<string>()))
            .Returns(JObject.FromObject(new { result = new { attachments = new object[0] } }).ToString());
        handler.InvokeCheckAttachmentsFromApi(request, response);
        Assert.True(response.IsSuccess);

        handler.WebRestServiceMock.Setup(x => x.GetAttachmentList(It.IsAny<string>(), It.IsAny<string>()))
            .Returns(JObject.FromObject(new { attachments = new[] { new { recnum = "R1" } } }).ToString());
        handler.InvokeCheckAttachmentsFromApi(request, response);
        Assert.False(response.IsSuccess);
    }

    [Fact]
    public void UpdateAttachmentRecordStatus_ShouldCoverAllBranches()
    {
        var handler = CreateHandler();
        var request = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                AttachmentId = "A1",
                LinkedAttachmentRecnum = "1",
                AttachmentRecnum = "2"
            }
        };

        handler.MFRDataAccessMock.Setup(x => x.GetAttachmentByRef(It.IsAny<string>()))
            .Returns(new ATTACHMENT());
        handler.InvokeUpdateAttachmentRecordStatus(request);

        request.Attachment.LinkedAttachmentRecnum = "0";
        handler.InvokeUpdateAttachmentRecordStatus(request);

        request.Attachment.AttachmentId = null;
        handler.InvokeUpdateAttachmentRecordStatus(request);
    }

    [Fact]
    public void DeleteAttachmentFromOCR_ShouldHandleAllBranches()
    {
        var handler = CreateHandler();
        var request = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                LinkedAttachmentRecnum = "1",
                AttachmentId = "",
                CreatedBy = "user"
            }
        };

        handler.InvokeDeleteAttachmentFromOCR(request);
        handler.ThrowInQueueSend = true;
        handler.InvokeDeleteAttachmentFromOCR(request);
    }

    // ---------- TESTABLE WRAPPER ----------
    private class TestableAttachmentsRequestHandler : AttachmentsRequestHandler
    {
        public Mock<MFRDataAccess> MFRDataAccessMock { get; } = new();
        public Mock<FileCheck> FileCheckMock { get; } = new();
        public Mock<IWebRestServiceManager> WebRestServiceMock { get; } = new();
        public bool ThrowInInsertCopyStatus { get; set; }
        public bool ThrowInQueueSend { get; set; }

        public TestableAttachmentsRequestHandler(ILogger logger, ILocalizedStrings localizedStrings, ISession session, IParameterAccess parameterAccess)
            : base(logger, localizedStrings, session, parameterAccess) { }

        // override data access creation
        protected override MFRDataAccess CreateMFRDataAccess() => MFRDataAccessMock.Object;
        protected override FileCheck CreateFileCheck() => FileCheckMock.Object;
        protected override IWebRestServiceManager CreateWebRestServiceManager(string user) => WebRestServiceMock.Object;

        protected override void InsertAttachmentCopyStatus(CreateAttachmentRequest req, string status)
        {
            if (ThrowInInsertCopyStatus)
                throw new Exception("Insert failed");
        }

        protected override ImportMessageQueueClient CreateQueueClient(string url, string name) =>
            ThrowInQueueSend ? throw new Exception("Queue fail") : new Mock<ImportMessageQueueClient>().Object;

        // expose private for coverage
        public void InvokeUpdateAttachmentDeleteStatus(CreateAttachmentRequest req, CreateAttachmentResponse res)
            => base.UpdateAttachmentDeleteStatus(req, res);

        public void InvokeCheckAttachmentsFromApi(CreateAttachmentRequest req, CreateAttachmentResponse res)
            => base.CheckAttachmentsFromApi(req, res);

        public void InvokeUpdateAttachmentRecordStatus(CreateAttachmentRequest req)
            => base.UpdateAttachmentRecordStatus(req);

        public void InvokeDeleteAttachmentFromOCR(CreateAttachmentRequest req)
            => base.DeleteAttachmentFromOCR(req);
    }
}
