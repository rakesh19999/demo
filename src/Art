    [Fact(DisplayName = "HandleMessage_AddAttachment_ShouldCreateAttachmentAndCopyFiles")]
    public void HandleMessage_AddAttachment_CreatesAttachmentAndCopiesFiles()
    {
        // Arrange
        var handler = CreateHandler();

        // Create chunk folder and file(s)
        string chunkDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(chunkDir);
        File.WriteAllBytes(Path.Combine(chunkDir, "1"), new byte[] { 10, 11, 12 });

        // Make parameter access return the repo paths used by FileCheck
        _param.Setup(p => p.GetParameterListItem("MFR", "Repository", "MfrCombinedChunksRepositoryLocation"))
              .Returns(chunkDir);
        string repoDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(repoDir);
        _param.Setup(p => p.GetParameterListItem("MFR", "Repository", "MfrAttachmentRepositoryLocation"))
              .Returns(repoDir);

        // Prepare fake MFRDataAccess that returns an ATTACHMENT when CreateNewAttachment is called
        var fake = new FakeMFRDataAccess(_param.Object, _logger.Object)
        {
            CreateNewAttachmentOverride = dto => new ATTACHMENT { ATTACHMENT_ID = dto.AttachmentId, CUSTOM_DATA = "x" },
            AddOrUpdateAttachmentsCopyStatusOverride = s => { /* no-op */ }
        };
        InjectFakeDataAccess(handler, fake);

        // Build the add attachment request DTO
        var req = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                AttachmentId = Guid.NewGuid().ToString(),
                RequestType = AttachmentActions.AddAttachment,
                Recnum = null,
                FilePath = chunkDir,
                CreatedBy = "user1"
            }
        };

        var header = new MessageHeader { SessionId = "S1" };

        // Act
        var result = handler.HandleMessage(header, req);

        // Assert
        Assert.NotNull(result);
        Assert.True(result.Response.Success);
        var respObj = Assert.IsType<CreateAttachmentResponse>(result.Message);
        Assert.True(respObj.IsSuccess);
        Assert.True(Directory.Exists(repoDir)); // repo created
        Assert.True(Directory.GetFiles(repoDir).Length >= 1); // file copied

        // Clean up
        Directory.Delete(chunkDir, true);
        Directory.Delete(repoDir, true);
    }

