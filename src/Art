public class AttachmentDto { public string AttachmentId { get; set; } public string RequestType { get; set; } public string Recnum { get; set; } public string FilePath { get; set; } public int ContentSize { get; set; } public string CreatedBy { get; set; } public string FormType { get; set; } public string FormRecnum { get; set; } public string AttachmentRecnum { get; set; } public string LinkedAttachmentRecnum { get; set; } }
