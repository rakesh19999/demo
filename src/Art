using Xunit;
using Moq;
using System;
using System.IO;
using System.Collections.Generic;
using Intergraph.MFR.ApprovalsModule;
using Intergraph.Framework.Contracts;
using Intergraph.Framework.Logging;
using Intergraph.Framework.Localization;
using Intergraph.MFR.DataAccess;
using Intergraph.MFR.DataAccess.Entities;

public class AttachmentsRequestHandlerTests
{
    private readonly Mock<ILogger> _loggerMock = new();
    private readonly Mock<ILocalizedStrings> _localizedStringsMock = new();
    private readonly Mock<IParameterAccess> _parameterAccessMock = new();
    private readonly Mock<ISession> _sessionMock = new();

    private AttachmentsRequestHandler CreateHandler()
    {
        return new AttachmentsRequestHandler(
            _loggerMock.Object,
            _localizedStringsMock.Object,
            _sessionMock.Object,
            _parameterAccessMock.Object
        );
    }

    [Fact]
    public void HandleMessage_ShouldHandle_AddAttachment_Successfully()
    {
        // Arrange
        var handler = CreateHandler();
        var tempDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(tempDir);

        // Create dummy files
        var dummyFile = Path.Combine(tempDir, "file1.txt");
        File.WriteAllText(dummyFile, "dummy data");

        _parameterAccessMock.Setup(x => x.GetParameterListItem("MFR", "Repository", "MfrCombinedChunksRepositoryLocation"))
                            .Returns(tempDir);

        var request = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                AttachmentId = Guid.NewGuid().ToString(),
                RequestType = AttachmentActions.AddAttachment,
                Recnum = null,
                FilePath = tempDir
            }
        };

        var header = new MessageHeader();

        // Act
        var result = handler.HandleMessage(header, request);

        // Assert
        Assert.NotNull(result);
        Assert.True(result.Response.Success);
        Directory.Delete(tempDir, true);
    }

