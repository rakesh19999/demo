    [Fact(DisplayName = "HandleMessage_WhenExceptionOccurs_LogsCriticalAndReturns")]
    public void HandleMessage_WhenExceptionOccurs_LogsCriticalAndReturns()
    {
        var handler = CreateHandler();

        // cause parameter access to throw inside handle -> triggers catch path
        _param.Setup(p => p.GetParameterListItem(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
              .Throws(new Exception("param fail"));

        var req = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto { RequestType = AttachmentActions.AddAttachment, AttachmentId = "a1" }
        };

        var res = handler.HandleMessage(new MessageHeader(), req);
        // handler sets response.Success true in catch per pasted code but also adds messages
        Assert.NotNull(res);
        Assert.True(res.Response.Success);
        Assert.NotEmpty(res.Response.Messages);
    }

    // -----------------------
    // Fake MFRDataAccess for tests (overrides virtual methods)
    // -----------------------
    public class FakeMFRDataAccess : MFRDataAccess
    {
        public Func<AttachmentDto, ATTACHMENT> CreateNewAttachmentOverride { get; set; }
        public Func<string, ATTACHMENT> GetAttachmentByRefOverride { get; set; }
        public Func<string, ATTACHMENTS_COPY_STATUS> GetAttachmentCopyStatusByReferenceIdOverride { get; set; }
        public Action<ATTACHMENTS_COPY_STATUS> AddOrUpdateAttachmentsCopyStatusOverride { get; set; }
        public Action<ATTACHMENT> AddOrUpdateAttachmentsOverride { get; set; }
        public Action<int> DeleteAttachmentOverride { get; set; }

        public FakeMFRDataAccess(IParameterAccess p, ILogger logger) : base(p, logger) { }

        public override ATTACHMENT CreateNewAttachment(AttachmentDto dto)
            => CreateNewAttachmentOverride != null ? CreateNewAttachmentOverride(dto) : base.CreateNewAttachment(dto);

        public override ATTACHMENT GetAttachmentByRef(string id)
            => GetAttachmentByRefOverride != null ? GetAttachmentByRefOverride(id) : base.GetAttachmentByRef(id);

        public override ATTACHMENTS_COPY_STATUS GetAttachmentCopyStatusByReferenceId(string id)
            => GetAttachmentCopyStatusByReferenceIdOverride != null ? GetAttachmentCopyStatusByReferenceIdOverride(id) : base.GetAttachmentCopyStatusByReferenceId(id);

        public override void AddOrUpdateAttachmentsCopyStatus(ATTACHMENTS_COPY_STATUS s)
        {
            if (AddOrUpdateAttachmentsCopyStatusOverride != null) AddOrUpdateAttachmentsCopyStatusOverride(s);
            else base.AddOrUpdateAttachmentsCopyStatus(s);
        }

        public override void AddOrUpdateAttachments(ATTACHMENT a)
        {
            if (AddOrUpdateAttachmentsOverride != null) AddOrUpdateAttachmentsOverride(a);
            else base.AddOrUpdateAttachments(a);
        }

        public override void DeleteAttachment(int recnum)
        {
            if (DeleteAttachmentOverride != null) DeleteAttachmentOverride(recnum);
            else base.DeleteAttachment(recnum);
        }
    }
