    [Fact(DisplayName = "InsertAttachmentCopyStatus_AllCases_CallsAddOrUpdate")]
    public void InsertAttachmentCopyStatus_AllCases_CallsAddOrUpdate()
    {
        var handler = CreateHandler();

        var req = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                AttachmentId = "att-1"
            }
        };

        var capturedStatuses = new List<ATTACHMENTS_COPY_STATUS>();
        var fake = new FakeMFRDataAccess(_param.Object, _logger.Object)
        {
            GetAttachmentCopyStatusByReferenceIdOverride = id => null,
            AddOrUpdateAttachmentsCopyStatusOverride = s => capturedStatuses.Add(s)
        };
        InjectFakeDataAccess(handler, fake);

        // call for Pending
        InvokePrivate(handler, "InsertAttachmentCopyStatus", req, FormStatus.Pending);
        // Success
        InvokePrivate(handler, "InsertAttachmentCopyStatus", req, FormStatus.Success);
        // Failed
        InvokePrivate(handler, "InsertAttachmentCopyStatus", req, FormStatus.Failed);

        Assert.True(capturedStatuses.Count >= 3);
        Assert.Contains(capturedStatuses, s => s.COPY_STATUS == FormStatus.Pending);
        Assert.Contains(capturedStatuses, s => s.COPY_STATUS == FormStatus.Success);
        Assert.Contains(capturedStatuses, s => s.COPY_STATUS == FormStatus.Failed);
    }

