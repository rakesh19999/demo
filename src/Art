    // Reflection helper: replaces private _mfrDataAccess field with fake
    private void InjectFakeDataAccess(object handler, FakeMFRDataAccess fake)
    {
        var field = handler.GetType().GetFields(BindingFlags.Instance | BindingFlags.NonPublic)
            .FirstOrDefault(f => f.FieldType == typeof(MFRDataAccess) || f.Name.ToLower().Contains("mfrdata"));
        if (field == null) throw new InvalidOperationException("Can't find MFRDataAccess private field to inject.");
        field.SetValue(handler, fake);
    }

    // Reflection helper: call private method
    private object InvokePrivate(object handler, string methodName, params object[] args)
    {
        var method = handler.GetType().GetMethod(methodName, BindingFlags.Instance | BindingFlags.NonPublic);
        if (method == null) throw new InvalidOperationException($"Method {methodName} not found");
        return method.Invoke(handler, args);
    }

