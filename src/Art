    [Fact]
    public void UpdateAttachmentDeleteStatus_Should_Set_Success_And_Failure()
    {
        var handler = CreateHandler();
        var attachment = new ATTACHMENT { IS_DELETED = true, ACK_MESSAGE = "Deleted" };
        var createResponse = new CreateAttachmentResponse();

        var request = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto { AttachmentId = "123" }
        };

        var dataAccessMock = new Mock<MFRDataAccess>(_parameterAccessMock.Object, _loggerMock.Object);
        dataAccessMock.Setup(x => x.GetAttachmentByRef("123")).Returns(attachment);

        handler.GetType().GetMethod("UpdateAttachmentDeleteStatus",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)
            .Invoke(handler, new object[] { request, createResponse });

        Assert.True(createResponse.IsSuccess);
    }

