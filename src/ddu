using Xunit;
using Moq;
using System;
using System.Threading.Tasks;
using System.Reflection;

public class DuiCommandModuleTests
{
    private readonly Mock<ILogger> _logger = new();
    private readonly Mock<IParameterAccess> _parameterAccess = new();
    private readonly Mock<IBaseServices> _baseServices = new();

    // Helper to create the instance
    private DuiCommandModule CreateModule()
    {
        return new DuiCommandModule(
            _baseServices.Object,
            _logger.Object,
            _parameterAccess.Object
        );
    }

    private void SetPrivateField(object obj, string name, object value)
    {
        obj.GetType()
           .GetField(name, BindingFlags.Instance | BindingFlags.NonPublic)
           .SetValue(obj, value);
    }

    [Fact]
    public async Task Initialize_WhenRabbitMq_ShouldRunSubscribeBlock()
    {
        // Arrange
        var module = CreateModule();

        // Make parameter return any admin name
        _parameterAccess.Setup(x => x.GetParameterListItem(
                It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
            .Returns("admin");

        // Force CheckIsRabbitMq() to return true
        var restService = new Mock<WebRMSRestService>("admin", _parameterAccess.Object);
        restService.Setup(x => x.CheckIsRabbitMq()).Returns(true);
        restService.Setup(x => x.GetRabbitMQSettings()).Returns(new RabbitMQSettings());

        // Replace real WebRMSRestService instance via reflection
        SetPrivateField(module, "webRMSRestService", restService.Object);

        // Act
        module.Initialize();
        await Task.Delay(150); // allow Task.Run to finish

        // Assert
        // No exception = path executed
        Assert.True(true);
    }

    [Fact]
    public void Initialize_WhenNotRabbitMq_ShouldCreateActiveMqConnection()
    {
        // Arrange
        var module = CreateModule();

        _parameterAccess.Setup(x => x.GetParameterListItem(
                It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
            .Returns("admin");

        // Mock service and force CheckIsRabbitMq() = false
        var restService = new Mock<WebRMSRestService>("admin", _parameterAccess.Object);
        restService.Setup(x => x.CheckIsRabbitMq()).Returns(false);

        SetPrivateField(module, "webRMSRestService", restService.Object);

        // Act
        module.Initialize();

        // Assert
        // Expect mfrActiveMQConnection to be created (not null)
        var field = typeof(DuiCommandModule)
            .GetField("mfrActiveMQConnection", BindingFlags.NonPublic | BindingFlags.Instance);

        var connection = field.GetValue(module);

        Assert.NotNull(connection);
    }

    [Fact]
    public void Dispose_WhenNotRabbitMq_ShouldDisposeActiveMqConnection()
    {
        // Arrange
        var module = CreateModule();

        // Pretend RabbitMq = false
        SetPrivateField(module, "isRabbitMq", false);

        // Inject mock connection
        var connectionMock = new Mock<MFRActiveMQConnection>(_parameterAccess.Object, _logger.Object, "DUI");
        SetPrivateField(module, "afrActiveMQConnection", connectionMock.Object);

        // Act
        module.Dispose();

        // Assert
        connectionMock.Verify(x => x.Dispose(), Times.Once);
    }

    [Fact]
    public void Dispose_WhenRabbitMq_ShouldNotDisposeConnection()
    {
        // Arrange
        var module = CreateModule();

        SetPrivateField(module, "isRabbitMq", true);

        var connectionMock = new Mock<MFRActiveMQConnection>(_parameterAccess.Object, _logger.Object, "DUI");
        SetPrivateField(module, "afrActiveMQConnection", connectionMock.Object);

        // Act
        module.Dispose();

        // Assert
        connectionMock.Verify(x => x.Dispose(), Times.Never);
    }

    [Fact]
    public void Dispose_WhenAlreadyDisposed_ShouldNotExecuteAgain()
    {
        // Arrange
        var module = CreateModule();

        SetPrivateField(module, "isRabbitMq", false);

        var connectionMock = new Mock<MFRActiveMQConnection>(_parameterAccess.Object, _logger.Object, "DUI");
        SetPrivateField(module, "afrActiveMQConnection", connectionMock.Object);

        // First dispose
        module.Dispose();

        // Second dispose (should not call Dispose again)
        module.Dispose();

        // Assert
        connectionMock.Verify(x => x.Dispose(), Times.Once);
    }
}
