[Fact]
public async Task Initialize_RabbitMqTrue_ShouldExecuteSubscribeBlock()
{
    // Arrange
    var logger = new Mock<ILogger>();
    var parameterAccess = new Mock<IParameterAccess>();
    var baseServices = new Mock<IBaseServices>();

    parameterAccess.Setup(x => x.GetParameterListItem(
        It.IsAny<string>(),
        It.IsAny<string>(),
        It.IsAny<string>()))
        .Returns("adminUser");

    // Force CheckIsRabbitMq to TRUE via SHIM
    var shim = new Mock<WebRMSRestService>("adminUser", parameterAccess.Object);
    shim.Setup(x => x.CheckIsRabbitMq()).Returns(true);
    shim.Setup(x => x.GetRabbitMQSettings()).Returns(new RabbitMQSettings());

    var module = new DuiCommandModule(baseServices.Object, logger.Object, parameterAccess.Object);

    // Inject fake object created above into local variable using reflection
    var field = typeof(DuiCommandModule).GetField("restServiceManager",
        BindingFlags.Instance | BindingFlags.NonPublic);
    field?.SetValue(module, shim.Object);

    // Create fake ImportUtil instance
    var util = new Mock<ImportUtil>(parameterAccess.Object, logger.Object);
    util.Setup(x => x.SubscribeToMessagingQueues(
        It.IsAny<string>(), true, It.IsAny<RabbitMQSettings>()));

    // Inject ImportUtil with reflection
    var utilField = typeof(DuiCommandModule).GetField("util",
        BindingFlags.Instance | BindingFlags.NonPublic);
    utilField?.SetValue(module, util.Object);

    // Act
    module.Initialize();

    // Wait for Task.Run to complete
    await Task.Delay(200);

    // Assert → means Initialize() executed and Task.Run didn't throw
    util.Verify(x => x.SubscribeToMessagingQueues(
        It.IsAny<string>(), true, It.IsAny<RabbitMQSettings>()),
        Times.Once);
}
[Fact]
public void Initialize_RabbitMqFalse_ShouldCreateActiveMQConnection()
{
    // Arrange
    var logger = new Mock<ILogger>();
    var parameterAccess = new Mock<IParameterAccess>();
    var baseServices = new Mock<IBaseServices>();

    parameterAccess.Setup(x => x.GetParameterListItem(
        It.IsAny<string>(),
        It.IsAny<string>(),
        It.IsAny<string>()))
        .Returns("adminUser");

    var shim = new Mock<WebRMSRestService>("adminUser", parameterAccess.Object);
    shim.Setup(x => x.CheckIsRabbitMq()).Returns(false);

    var module = new DuiCommandModule(baseServices.Object, logger.Object, parameterAccess.Object);

    // Inject fake rest service
    var field = typeof(DuiCommandModule).GetField("restServiceManager",
        BindingFlags.Instance | BindingFlags.NonPublic);
    field?.SetValue(module, shim.Object);

    // Act
    module.Initialize();

    // Assert: ActiveMQ connection created
    var mqField = typeof(DuiCommandModule).GetField("mfrActiveMQConnection",
        BindingFlags.Instance | BindingFlags.NonPublic);

    Assert.NotNull(mqField.GetValue(module));
}
