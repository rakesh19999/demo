using Xunit;
using Moq;
using System.Threading.Tasks;

public class DUICommandModuleTests
{
    private readonly Mock<ILogger> mockLogger = new();
    private readonly Mock<IParameterAccess> mockParameterAccess = new();
    private readonly Mock<ITracer> mockTracer = new();
    private readonly Mock<IMFRActiveMQConnection> mockActiveMqConn = new();
    private readonly Mock<WebRMSRestService> mockRestService;

    public DUICommandModuleTests()
    {
        mockLogger.Setup(l => l.GetTracer()).Returns(mockTracer.Object);
    }

    private DUICommandModule CreateModule(bool isRabbitMq)
    {
        var module = new DUICommandModule(
            Mock.Of<IBaseServices>(),
            mockLogger.Object,
            mockParameterAccess.Object
        );

        // Mock rest service behavior
        Mock.Get(new WebRMSRestService("admin", mockParameterAccess.Object))
            .Setup(r => r.CheckIsRabbitMq())
            .Returns(isRabbitMq);

        return module;
    }

    // ============================
    //  TEST 1: RabbitMQ Branch
    // ============================
    [Fact]
    public void Initialize_RabbitMqFlow_ShouldSubscribeToQueues()
    {
        // Arrange
        var module = CreateModule(isRabbitMq: true);

        var restMock = new Mock<WebRMSRestService>("admin", mockParameterAccess.Object);
        restMock.Setup(r => r.CheckIsRabbitMq()).Returns(true);
        restMock.Setup(r => r.GetRabbitMQSettings()).Returns(new RabbitMQSettings());

        // Act
        module.Initialize();
        Task.Delay(200).Wait();   // allow Task.Run execution

        // Assert
        restMock.Verify(r => r.GetRabbitMQSettings(), Times.AtLeastOnce());
    }

    // ======================================
    //  TEST 2: ActiveMQ Branch
    // ======================================
    [Fact]
    public void Initialize_ActiveMqFlow_ShouldCreateActiveMqConnection()
    {
        // Arrange
        var module = CreateModule(isRabbitMq: false);

        // Inject dummy ActiveMQ connection
        SetPrivateActiveMq(module, mockActiveMqConn.Object);

        // Act
        module.Initialize();

        // Assert
        Assert.NotNull(GetPrivateActiveMq(module));
    }

    // helper to read private field
    private IMFRActiveMQConnection GetPrivateActiveMq(DUICommandModule module)
    {
        var field = typeof(DUICommandModule)
            .GetField("mfrActiveMQConnection", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);

        return (IMFRActiveMQConnection)field.GetValue(module);
    }

    private void SetPrivateActiveMq(DUICommandModule module, IMFRActiveMQConnection conn)
    {
        var field = typeof(DUICommandModule)
            .GetField("mfrActiveMQConnection", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);

        field.SetValue(module, conn);
    }

    // ======================================
    //  TEST 3: Dispose() when ActiveMQ
    // ======================================
    [Fact]
    public void Dispose_WhenActiveMq_ShouldDisposeConnection()
    {
        // Arrange
        var module = CreateModule(false);
        SetPrivateActiveMq(module, mockActiveMqConn.Object);

        // Act
        module.Dispose();

        // Assert
        mockLogger.Verify(l => l.Debug("Disposing"), Times.Once);
        mockActiveMqConn.Verify(a => a.Dispose(), Times.Once);
    }

    // ======================================
    //  TEST 4: Dispose() when RabbitMQ
    // ======================================
    [Fact]
    public void Dispose_WhenRabbitMq_ShouldNotDisposeActiveMq()
    {
        // Arrange
        var module = CreateModule(true);
        SetPrivateActiveMq(module, mockActiveMqConn.Object);

        // Act
        module.Dispose();

        // Assert
        mockLogger.Verify(l => l.Debug("Disposing"), Times.Once);
        mockActiveMqConn.Verify(a => a.Dispose(), Times.Never);
    }

    // ======================================
    //  TEST 5: Dispose twice
    // ======================================
    [Fact]
    public void Dispose_CalledTwice_ShouldRunOnlyOnce()
    {
        // Arrange
        var module = CreateModule(true);

        // Act
        module.Dispose();
        module.Dispose();

        // Assert
        mockLogger.Verify(l => l.Debug("Disposing"), Times.Once);  // only first call
    }
}
