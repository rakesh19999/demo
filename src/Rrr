        // Helper: set a private (readonly) field via reflection
        private void SetPrivateField(object target, string fieldName, object value)
        {
            var fi = target.GetType()
                           .GetFields(BindingFlags.Instance | BindingFlags.NonPublic)
                           .FirstOrDefault(f => f.Name.Equals(fieldName, StringComparison.OrdinalIgnoreCase));
            if (fi == null)
                throw new InvalidOperationException($"Field '{fieldName}' not found on {target.GetType().FullName}");
            fi.SetValue(target, value);
        }

        // Helper: invoke a private instance method and return result
        private object InvokePrivateMethod(object target, string methodName, params object[] parameters)
        {
            var mi = target.GetType()
                           .GetMethods(BindingFlags.NonPublic | BindingFlags.Instance)
                           .FirstOrDefault(m => m.Name.Equals(methodName, StringComparison.OrdinalIgnoreCase));
            if (mi == null)
                throw new InvalidOperationException($"Method '{methodName}' not found on {target.GetType().FullName}");
            return mi.Invoke(target, parameters);
        }

