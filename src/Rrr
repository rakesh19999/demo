using Xunit;
using Moq;
using System;
using Intergraph.MFR.ApprovalsModule;
using Intergraph.Framework.Contracts;
using Intergraph.Framework.Logging;
using Intergraph.Framework.Localization;
using Intergraph.MFR.DataAccess;
using Intergraph.MFR.DataAccess.Entities;

public class GetAttachmentsCopyStatusRequestHandlerTests
{
    private readonly Mock<ILogger> _loggerMock = new();
    private readonly Mock<ILocalizedStrings> _localStringsMock = new();
    private readonly Mock<IParameterAccess> _parameterAccessMock = new();
    private readonly Mock<MFRDataAccess> _mfrDataAccessMock;

    public GetAttachmentsCopyStatusRequestHandlerTests()
    {
        _mfrDataAccessMock = new Mock<MFRDataAccess>(_parameterAccessMock.Object, _loggerMock.Object);
    }

    private class TestableHandler : GetAttachmentsCopyStatusRequestHandler
    {
        private readonly MFRDataAccess _dataAccess;

        public TestableHandler(ILogger logger, ILocalizedStrings localizedStrings, IParameterAccess parameterAccess, MFRDataAccess dataAccess)
            : base(logger, localizedStrings, parameterAccess)
        {
            _dataAccess = dataAccess;
        }

        // override to return mock instance
        protected override MFRDataAccess CreateDataAccess() => _dataAccess;
    }

    private GetAttachmentsCopyStatusRequestHandler CreateHandler() =>
        new TestableHandler(_loggerMock.Object, _localStringsMock.Object, _parameterAccessMock.Object, _mfrDataAccessMock.Object);

    [Fact]
    public void HandleMessage_ShouldReturnSuccess_WhenStatusFetched()
    {
        // Arrange
        var handler = CreateHandler();
        var request = new MFRGetAttachmentCopyStatusRequest { AttachmentId = "123" };
        var header = new MessageHeader();

        var expectedStatus = new ATTACHMENTS_COPY_STATUS { COPY_STATUS = "Completed" };
        _mfrDataAccessMock.Setup(x => x.GetAttachmentCopyStatusByReferenceId("123"))
                          .Returns(expectedStatus);

        // Act
        var result = handler.HandleMessage(header, request);

        // Assert
        var response = (MFRGetAttachmentCopyStatusResponse)result.Message;
        Assert.True(result.Response.Success);
        Assert.Equal("Completed", response.attachmentCopyStatus);
    }

    [Fact]
    public void HandleMessage_ShouldReturnFailure_WhenExceptionThrown()
    {
        // Arrange
        var handler = CreateHandler();
        var request = new MFRGetAttachmentCopyStatusRequest { AttachmentId = "123" };
        var header = new MessageHeader();

        _mfrDataAccessMock.Setup(x => x.GetAttachmentCopyStatusByReferenceId("123"))
                          .Throws(new Exception("DB Error"));

        // Act
        var result = handler.HandleMessage(header, request);

        // Assert
        Assert.False(result.Response.Success);

        // safer check
        Assert.Contains(result.Response.Messages, msg => msg.Contains("DB Error", StringComparison.OrdinalIgnoreCase));
    }
}
