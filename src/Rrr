public class AttachmentsRequestHandlerTests
{
    private readonly Mock<ILogger> _logger = new();
    private readonly Mock<ILocalizedStrings> _localized = new();
    private readonly Mock<ISession> _session = new();
    private readonly Mock<IParameterAccess> _param = new();

    // Create handler instance from production constructor
    private AttachmentsRequestHandler CreateHandler()
    {
        return new AttachmentsRequestHandler(
            _logger.Object,
            _localized.Object,
            _session.Object,
            _param.Object
        );
    }

    // Replace first non-public instance field of type MFRDataAccess inside handler with our fake.
    private void InjectFakeDataAccess(object handler, FakeMFRDataAccess fake)
    {
        var handlerType = handler.GetType();
        var field = handlerType.GetFields(BindingFlags.Instance | BindingFlags.NonPublic)
            .FirstOrDefault(f => f.FieldType == typeof(MFRDataAccess) || f.FieldType.IsSubclassOf(typeof(MFRDataAccess)));

        if (field == null)
            throw new InvalidOperationException("Could not find a private field of type MFRDataAccess in handler to replace. Update test to target correct field name.");

        field.SetValue(handler, fake);
    }

    private CreateAttachmentRequest BuildAddRequest(string chunkDir)
    {
        // Adjust this to match your actual Attachment DTO type
        var dto = new AttachmentDto
        {
            AttachmentId = Guid.NewGuid().ToString(),
            RequestType = AttachmentActions.AddAttachment,
            Recnum = null,
            FilePath = chunkDir,
            ContentSize = 0,
            FormType = "REPORT",
            FormRecnum = "123",
            CreatedBy = "user1",
            AttachmentRecnum = "999",
            LinkedAttachmentRecnum = "0"
        };

        return new CreateAttachmentRequest { Attachment = dto };
    }

    [Fact(DisplayName = "AddAttachment - happy path: creates DB record and copies file to repository")]
    public void AddAttachment_HappyPath_CreatesAndCopiesFile()
    {
        // Arrange: create chunk dir with one file
        string chunkDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(chunkDir);
        File.WriteAllBytes(Path.Combine(chunkDir, "1"), new byte[] { 1, 2, 3 });

        // repository path where MoveFileToOCRSharedPath will write final file
        string repoDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(repoDir);

        // ParameterAccess used by FileCheck to build paths
        _param.Setup(p => p.GetParameterListItem("MFR", "Repository", "AfrCombinedChunksRepositoryLocation"))
              .Returns(chunkDir);
        _param.Setup(p => p.GetParameterListItem("MFR", "Repository", "AfrAttachmentRepositoryLocation"))
              .Returns(repoDir);

        // Create handler and inject fake data access that returns a created ATTACHMENT
        var handler = CreateHandler();
        var fakeData = new ATTACHMENT { CUSTOM_DATA = "orig", ATTACHMENT_ID = "a1" };
        var fake = new FakeMFRDataAccess(_param.Object, _logger.Object)
        {
            CreateNewAttachmentOverride = (attDto) => fakeData
        };
        InjectFakeDataAccess(handler, fake);

        var req = BuildAddRequest(chunkDir);

        // Act
        var resp = handler.HandleMessage(new MessageHeader { SessionId = "s1" }, req);

        // Assert
        Assert.True(resp.Response.Success);
        var createResp = Assert.IsType<CreateAttachmentResponse>(resp.Message);
        Assert.True(createResp.IsSuccess);
        Assert.NotNull(createResp.CustomData);
        // repository should contain copied file
        var repoFiles = Directory.GetFiles(repoDir);
        Assert.True(repoFiles.Length >= 1);

        // cleanup
        Directory.Delete(chunkDir, true);
        Directory.Delete(repoDir, true);
    }

    [Fact(DisplayName = "AddAttachment - empty chunk directory still returns success")]
    public void AddAttachment_EmptyDir_Succeeds()
    {
        // Arrange: empty chunk dir
        string chunkDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(chunkDir);

        string repoDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(repoDir);

        _param.Setup(p => p.GetParameterListItem("MFR", "Repository", "AfrCombinedChunksRepositoryLocation"))
              .Returns(chunkDir);
        _param.Setup(p => p.GetParameterListItem("MFR", "Repository", "AfrAttachmentRepositoryLocation"))
              .Returns(repoDir);

        var handler = CreateHandler();
        var fake = new FakeMFRDataAccess(_param.Object, _logger.Object)
        {
            CreateNewAttachmentOverride = (attDto) => new ATTACHMENT()
        };
        InjectFakeDataAccess(handler, fake);

        var req = BuildAddRequest(chunkDir);

        // Act
        var resp = handler.HandleMessage(new MessageHeader { SessionId = "s2" }, req);

        // Assert
        Assert.True(resp.Response.Success);
        var createResp = Assert.IsType<CreateAttachmentResponse>(resp.Message);
        Assert.True(createResp.IsSuccess);

        Directory.Delete(chunkDir, true);
        Directory.Delete(repoDir, true);
    }

    [Fact(DisplayName = "UpdateAttachmentDeleteStatus - when attachment exists and is deleted (ACK true)")]
    public void UpdateAttachmentDeleteStatus_AttachmentExists_IsDeleted()
    {
        // Arrange
        var handler = CreateHandler();

        var req = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                AttachmentId = "ref-1",
                RequestType = AttachmentActions.AttachmentDeleteStatus,
                CreatedBy = "user1"
            }
        };

        var fake = new FakeMFRDataAccess(_param.Object, _logger.Object)
        {
            GetAttachmentByRefOverride = (refId) => new ATTACHMENT { IS_DELETED = true, ACK_MESSAGE = "ACK_OK" }
        };
        InjectFakeDataAccess(handler, fake);

        // Act
        var resp = handler.HandleMessage(new MessageHeader(), req);

        // Assert
        Assert.True(resp.Response.Success);
        var createResp = Assert.IsType<CreateAttachmentResponse>(resp.Message);
        Assert.True(createResp.IsSuccess);
        Assert.Equal("ACK_OK", createResp.Message);
    }

    [Fact(DisplayName = "UpdateAttachmentDeleteStatus - when attachment exists but not deleted (ACK false)")]
    public void UpdateAttachmentDeleteStatus_AttachmentExists_NotDeleted()
    {
        var handler = CreateHandler();

        var req = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                AttachmentId = "ref-2",
                RequestType = AttachmentActions.AttachmentDeleteStatus,
                CreatedBy = "user1"
            }
        };

        var fake = new FakeMFRDataAccess(_param.Object, _logger.Object)
        {
            GetAttachmentByRefOverride = (refId) => new ATTACHMENT { IS_DELETED = false, ACK_MESSAGE = "PENDING" }
        };
        InjectFakeDataAccess(handler, fake);

        var resp = handler.HandleMessage(new MessageHeader(), req);

        Assert.True(resp.Response.Success);
        var createResp = Assert.IsType<CreateAttachmentResponse>(resp.Message);
        Assert.False(createResp.IsSuccess);
        Assert.Equal("PENDING", createResp.Message);
    }

    [Fact(DisplayName = "DeleteAttachmentFromOCR - short-circuits when linked recnum is zero or missing")]
    public void DeleteAttachmentFromOCR_LinkedRecnumMissing_ShortCircuits()
    {
        var handler = CreateHandler();

        var req = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                RequestType = AttachmentActions.DeleteAttachment,
                LinkedAttachmentRecnum = "0",
                AttachmentId = "ref-x",
                CreatedBy = "user1"
            }
        };

        var resp = handler.HandleMessage(new MessageHeader(), req);

        Assert.True(resp.Response.Success);
        var createResp = Assert.IsType<CreateAttachmentResponse>(resp.Message);
        // createResp.IsSuccess expected true based on handler flow for delete
        Assert.True(createResp.IsSuccess);
    }

    [Fact(DisplayName = "InsertAttachmentCopyStatus - executes without exception (Add flow)")]
    public void InsertAttachmentCopyStatus_NoException()
    {
        // Arrange
        string repoDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(repoDir);

        _param.Setup(p => p.GetParameterListItem("MFR", "Repository", "AfrAttachmentRepositoryLocation"))
              .Returns(repoDir);

        var handler = CreateHandler();
        var fake = new FakeMFRDataAccess(_param.Object, _logger.Object)
        {
            GetAttachmentCopyStatusByReferenceIdOverride = (id) => null,
            AddOrUpdateAttachmentsCopyStatusOverride = (s) => { /* do nothing */ }
        };
        InjectFakeDataAccess(handler, fake);

        var req = BuildAddRequest(repoDir);

        var resp = handler.HandleMessage(new MessageHeader(), req);

        Assert.True(resp.Response.Success);

        Directory.Delete(repoDir, true);
    }

    [Fact(DisplayName = "HandleMessage - when parameter access throws -> handler catches and logs")]
    public void HandleMessage_ParameterAccessThrows_GracefulFailure()
    {
        _param.Setup(p => p.GetParameterListItem(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
              .Throws(new Exception("param fail"));

        var handler = CreateHandler();
        var fake = new FakeMFRDataAccess(_param.Object, _logger.Object);
        InjectFakeDataAccess(handler, fake);

        var req = BuildAddRequest(Path.Combine(Path.GetTempPath(), "x"));

        var resp = handler.HandleMessage(new MessageHeader(), req);

        Assert.False(resp.Response.Success);
        _logger.Verify(l => l.Critical(It.IsAny<string>(), It.IsAny<Exception>()), Times.AtLeastOnce);
    }

    // -----------------------------
    // Fake MFRDataAccess test double
    // -----------------------------
    public class FakeMFRDataAccess : MFRDataAccess
    {
        public Func<AttachmentDto, ATTACHMENT> CreateNewAttachmentOverride { get; set; }
        public Func<string, ATTACHMENT> GetAttachmentByRefOverride { get; set; }
        public Func<string, ATTACHMENTS_COPY_STATUS> GetAttachmentCopyStatusByReferenceIdOverride { get; set; }
        public Action<ATTACHMENTS_COPY_STATUS> AddOrUpdateAttachmentsCopyStatusOverride { get; set; }
        public Action<ATTACHMENT> AddOrUpdateAttachmentsOverride { get; set; }
        public Action<int> DeleteAttachmentOverride { get; set; }

        public FakeMFRDataAccess(IParameterAccess param, ILogger logger)
            : base(param, logger)
        {
        }

        // override these methods - ensure these methods are virtual in MFRDataAccess
        public override ATTACHMENT CreateNewAttachment(AttachmentDto dto)
        {
            if (CreateNewAttachmentOverride != null) return CreateNewAttachmentOverride(dto);
            return base.CreateNewAttachment(dto);
        }

        public override ATTACHMENT GetAttachmentByRef(string refId)
        {
            if (GetAttachmentByRefOverride != null) return GetAttachmentByRefOverride(refId);
            return base.GetAttachmentByRef(refId);
        }

        public override ATTACHMENTS_COPY_STATUS GetAttachmentCopyStatusByReferenceId(string id)
        {
            if (GetAttachmentCopyStatusByReferenceIdOverride != null) return GetAttachmentCopyStatusByReferenceIdOverride(id);
            return base.GetAttachmentCopyStatusByReferenceId(id);
        }

        public override void AddOrUpdateAttachmentsCopyStatus(ATTACHMENTS_COPY_STATUS status)
        {
            if (AddOrUpdateAttachmentsCopyStatusOverride != null) AddOrUpdateAttachmentsCopyStatusOverride(status);
            else base.AddOrUpdateAttachmentsCopyStatus(status);
        }

        public override void AddOrUpdateAttachments(ATTACHMENT attachment)
        {
            if (AddOrUpdateAttachmentsOverride != null) AddOrUpdateAttachmentsOverride(attachment);
            else base.AddOrUpdateAttachments(attachment);
        }

        public override void DeleteAttachment(int recnum)
        {
            if (DeleteAttachmentOverride != null) DeleteAttachmentOverride(recnum);
            else base.DeleteAttachment(recnum);
        }
    }
}
