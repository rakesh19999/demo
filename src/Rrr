using Xunit;
using Moq;
using System;
using Intergraph.MFR.ApprovalsModule;
using Intergraph.Framework.Contracts;
using Intergraph.Framework.Logging;
using Intergraph.Framework.Localization;
using Intergraph.MFR.DataAccess;
using Intergraph.MFR.DataAccess.Entities;

// ✅ Create a testable subclass inside the test file only
public class TestableMFRDataAccess : MFRDataAccess
{
    private readonly Func<string, ATTACHMENTS_COPY_STATUS> _getStatusFunc;

    public TestableMFRDataAccess(
        IParameterAccess parameterAccess,
        ILogger logger,
        Func<string, ATTACHMENTS_COPY_STATUS> getStatusFunc = null
    ) : base(parameterAccess, logger)
    {
        _getStatusFunc = getStatusFunc;
    }

    public override ATTACHMENTS_COPY_STATUS GetAttachmentCopyStatusByReferenceId(string referenceId)
    {
        if (_getStatusFunc != null)
            return _getStatusFunc(referenceId);

        return base.GetAttachmentCopyStatusByReferenceId(referenceId);
    }
}

public class GetAttachmentsCopyStatusRequestHandlerTests
{
    private readonly Mock<ILogger> _loggerMock = new();
    private readonly Mock<ILocalizedStrings> _localStringsMock = new();
    private readonly Mock<IParameterAccess> _parameterAccessMock = new();

    private GetAttachmentsCopyStatusRequestHandler CreateHandler()
    {
        return new GetAttachmentsCopyStatusRequestHandler(
            _loggerMock.Object,
            _localStringsMock.Object,
            _parameterAccessMock.Object
        );
    }

    [Fact]
    public void HandleMessage_ShouldReturnSuccess_WhenStatusFetched()
    {
        // Arrange
        var expectedStatus = new ATTACHMENTS_COPY_STATUS { COPY_STATUS = "Completed" };

        var dataAccess = new TestableMFRDataAccess(
            _parameterAccessMock.Object,
            _loggerMock.Object,
            _ => expectedStatus
        );

        var handler = CreateHandler();
        var request = new MFRGetAttachmentCopyStatusRequest { AttachmentId = "123" };
        var header = new MessageHeader();

        // Act
        var result = handler.HandleMessage(header, request);

        // Assert
        var response = Assert.IsType<MFRGetAttachmentCopyStatusResponse>(result.Message);
        Assert.True(result.Response.Success);
        Assert.Equal("Completed", response.attachmentCopyStatus);
    }

    [Fact]
    public void HandleMessage_ShouldReturnFailure_WhenExceptionThrown()
    {
        // Arrange
        var dataAccess = new TestableMFRDataAccess(
            _parameterAccessMock.Object,
            _loggerMock.Object,
            _ => throw new Exception("DB Error")
        );

        var handler = CreateHandler();
        var request = new MFRGetAttachmentCopyStatusRequest { AttachmentId = "123" };
        var header = new MessageHeader();

        // Act
        var result = handler.HandleMessage(header, request);

        // Assert
        Assert.False(result.Response.Success);
        Assert.Contains("DB Error", result.Response.Messages[0]);
    }
}
