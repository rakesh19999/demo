        [Fact]
        public void HandleMessage_WhenExceptionOccurs_InsertsFailedCopyStatusAndReturnsErrorMessage()
        {
            // Arrange
            var handler = CreateHandlerWithMocks(
                out var loggerMock,
                out var localizedStringsMock,
                out var sessionMock,
                out var parameterAccessMock,
                out var mfrDataAccessMock
            );

            // Make parameterAccess throw during construction usage or GetParameterListItem to cause exception in Handle.
            parameterAccessMock.Setup(p => p.GetParameterListItem(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
                .Throws(new InvalidOperationException("boom"));

            var header = new MessageHeader { SessionId = "S1" };
            var request = new CreateAttachmentRequest
            {
                Attachment = new AttachmentDto
                {
                    AttachmentId = "ATT-err",
                    RequestType = AttachmentActions.AddAttachment,
                    // minimal properties
                }
            };

            // Spy on AddOrUpdateAttachmentsCopyStatus to capture call
            ATTACHMENTS_COPY_STATUS captured = null;
            mfrDataAccessMock.Setup(m => m.AddOrUpdateAttachmentsCopyStatus(It.IsAny<ATTACHMENTS_COPY_STATUS>()))
                .Callback<ATTACHMENTS_COPY_STATUS>(s => captured = s);

            // Act
            // Call the public handler method. Adjust method name if different in your class (HandleMessage vs Handlellessage).
            var messageResponse = handler.HandleMessage(header, request);

            // Assert: response contains an error message and we recorded a Failed copy status inserted
            messageResponse.Response.Success.Should().BeTrue();
            messageResponse.Response.Messages.Should().Contain(m => m.Contains("boom") || m.Contains("Error"));

            captured.Should().NotBeNull();
            captured.COPY_STATUS.Should().Be("Failed");
        }
