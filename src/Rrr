        [Fact]
        public void InsertAttachmentCopyStatus_WhenPending_CreatesPendingRecord()
        {
            // Arrange
            var handler = CreateHandlerWithMocks(
                out var loggerMock,
                out var localizedStringsMock,
                out var sessionMock,
                out var parameterAccessMock,
                out var mfrDataAccessMock
            );

            // Build a simple CreateAttachmentRequest with AttachmentId
            var request = new CreateAttachmentRequest
            {
                Attachment = new AttachmentDto
                {
                    AttachmentId = "ATT-123",
                    // other properties as required by your DTO
                }
            };

            // Mock FileCheck to return some full path if required by InsertAttachmentCopyStatus logic.
            // The code in your handler uses FileCheck and mfrDataAccess.GetAttachmentCopyStatus...
            // Here we'll mock MFRDataAccess.AddOrUpdateAttachmentsCopyStatus to capture the value passed
            ATTACHMENTS_COPY_STATUS captured = null;
            mfrDataAccessMock.Setup(m => m.AddOrUpdateAttachmentsCopyStatus(It.IsAny<ATTACHMENTS_COPY_STATUS>()))
                .Callback<ATTACHMENTS_COPY_STATUS>(s => captured = s);

            // Act: call private InsertAttachmentCopyStatus(request, FormStatus.Pending)
            // Note: the method signature in the handler uses strings/consts; adapt name/params to real code.
            InvokePrivateMethod(handler, "InsertAttachmentCopyStatus", request, "Pending");

            // Assert
            captured.Should().NotBeNull();
            captured.ATTACHMENT_ID.Should().Be("ATT-123");
            captured.COPY_STATUS.Should().Be("Pending"); // matches FormStatus.Pending in pasted code
            captured.CREATED_ON.Should().BeCloseTo(DateTime.Now, TimeSpan.FromSeconds(5));
        }

        [Fact]
        public void UpdateAttachmentRecordStatus_WhenLinkedAttachmentRecnum_PendingAckMessageSet()
        {
            // Arrange
            var handler = CreateHandlerWithMocks(
                out var loggerMock,
                out var localizedStringsMock,
                out var sessionMock,
                out var parameterAccessMock,
                out var mfrDataAccessMock
            );

            // Prepare request with linked attachment recnum and a fake AttachmentId.
            var request = new CreateAttachmentRequest
            {
                Attachment = new AttachmentDto
                {
                    AttachmentId = "ATT-999",
                    LinkedAttachmentRecnum = "123",
                    AttachmentRecnum = "0"
                }
            };

            // Prepare an ATTACHMENT returned by GetAttachmentByRef
            var existing = new ATTACHMENT
            {
                ATTACHMENT_ID = "ATT-999",
                IS_DELETED = false,
                ACK_MESSAGE = null
            };

            mfrDataAccessMock.Setup(m => m.GetAttachmentByRef("ATT-999")).Returns(existing);

            // Capture the saved attachment
            ATTACHMENT saved = null;
            mfrDataAccessMock.Setup(m => m.AddOrUpdateAttachments(It.IsAny<ATTACHMENT>()))
                .Callback<ATTACHMENT>(a => saved = a);

            // Act
            InvokePrivateMethod(handler, "UpdateAttachmentRecordStatus", request);

            // Assert - in the pasted code when linked recnum > 0 it sets ACK_MESSAGE to PendingDelete
            saved.Should().NotBeNull();
            saved.ACK_MESSAGE.Should().Be("Pending Delete"); // constant in original code
            saved.UPDATED_ON.Should().BeCloseTo(DateTime.Now, TimeSpan.FromSeconds(5));
        }

