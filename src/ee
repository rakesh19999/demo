[Fact]
public void InsertAttachmentCopyStatus_Covers_All_Paths()
{
    // Arrange
    var parameterMock = new Mock<IParameterAccess>();
    var loggerMock = new Mock<ILogger>();

    // Fake parameter return value used in GetFullPathName
    parameterMock.Setup(p => p.GetParameterListItem("MFR", "Repository", "MfrAttachmentRepositoryLocation"))
                 .Returns("C:\\TempRepo");

    // Fake attachment request
    var request = new CreateAttachmentRequest
    {
        Attachment = new ATTACHMENT
        {
            AttachmentId = "ATT123"
        }
    };

    // Create handler using reflection-safe constructor
    var handler = new AttachmentsRequestHandler(loggerMock.Object, null!, null!, parameterMock.Object);

    // ====== REFLECTION TO ACCESS PRIVATE METHOD ======
    var method = typeof(AttachmentsRequestHandler)
                    .GetMethod("InsertAttachmentCopyStatus",
                        BindingFlags.Instance | BindingFlags.NonPublic);

    Assert.NotNull(method);

    // ========= CALL ALL STATUS CASES ============
    method.Invoke(handler, new object[] { request, FormStatus.Pending });
    method.Invoke(handler, new object[] { request, FormStatus.Success });
    method.Invoke(handler, new object[] { request, FormStatus.Failed });
    method.Invoke(handler, new object[] { request, "OTHER" }); // enters default branch

    // ========= FORCE CATCH BLOCK ============
    // parameterAccess returns NULL -> GetFullPathName will throw 
    parameterMock.Setup(p => p.GetParameterListItem(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
                 .Returns((string)null);

    method.Invoke(handler, new object[] { request, FormStatus.Pending });

    // Assert: just ensure no exception escaped
    Assert.True(true);
}
