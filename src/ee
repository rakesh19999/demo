using Xunit;
using Moq;
using Apache.NMS;
using System;
using System.Reflection;

public class ActiveMQSubscribeTopicTests
{
    private readonly Mock<IParameterAccess> _param;
    private readonly Mock<ILogger> _logger;
    private readonly Mock<IConnectionFactory> _factory;
    private readonly Mock<IConnection> _conn;
    private readonly Mock<ISession> _session;
    private readonly Mock<IMessageConsumer> _consumer;

    public ActiveMQSubscribeTopicTests()
    {
        _param = new Mock<IParameterAccess>();
        _logger = new Mock<ILogger>();
        _factory = new Mock<IConnectionFactory>();
        _conn = new Mock<IConnection>();
        _session = new Mock<ISession>();
        _consumer = new Mock<IMessageConsumer>();
    }

    private ActiveMQSubscribeTopic CreateTopic()
    {
        // Mock parameter
        _param.Setup(x => x.GetParameterListItem(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
              .Returns("DummyTopic");

        // Mock connection factory
        _factory.Setup(x => x.CreateConnection()).Returns(_conn.Object);

        // Mock session
        _conn.Setup(x => x.CreateSession(It.IsAny<AcknowledgementMode>()))
             .Returns(_session.Object);

        // Mock consumer
        _session.Setup(x => x.CreateConsumer(It.IsAny<IDestination>(), null))
                .Returns(_consumer.Object);

        // Force the constructor to use our mocked ConnectionFactory using reflection
        var topic = (ActiveMQSubscribeTopic)Activator.CreateInstance(
            typeof(ActiveMQSubscribeTopic),
            BindingFlags.Public | BindingFlags.Instance,
            binder: null,
            args: new object[]
            {
                "TestTopic",
                "tcp://localhost:61616",
                "C:/Output",
                AcknowledgementMode.AutoAcknowledge,
                _param.Object,
                _logger.Object
            },
            culture: null
        );

        // Inject mocked factory using reflection
        var factoryField = typeof(ActiveMQSubscribeTopic).GetField("connectionFactory", BindingFlags.NonPublic | BindingFlags.Instance);
        factoryField.SetValue(topic, _factory.Object);

        return topic;
    }

    // -----------------------------
    //  Test Constructor + InitConnection
    // -----------------------------
    [Fact]
    public void Constructor_ShouldInitialize_AndCreateConnection()
    {
        var topic = CreateTopic();

        _factory.Verify(f => f.CreateConnection(), Times.Once);
        _conn.Verify(c => c.Start(), Times.Once);
        Assert.NotNull(topic.GetConsumer());
    }

    // -----------------------------
    //  GetConsumer Test
    // -----------------------------
    [Fact]
    public void GetConsumer_ShouldReturnConsumer()
    {
        var topic = CreateTopic();

        var consumer = topic.GetConsumer();

        Assert.NotNull(consumer);
    }

    // -----------------------------
    //  Dispose Test
    // -----------------------------
    [Fact]
    public void Dispose_ShouldCleanUpAllConnections()
    {
        var topic = CreateTopic();

        topic.Dispose();

        _consumer.Verify(c => c.Close(), Times.Once);
        _session.Verify(s => s.Close(), Times.Once);
        _conn.Verify(c => c.Close(), Times.Once);
    }

    // -----------------------------
    //  Report Message Listener Test
    // -----------------------------
    [Fact]
    public void OnReportMessageListener_ShouldProcessMessage()
    {
        var topic = CreateTopic();

        var message = new Mock<ITextMessage>();
        message.Setup(m => m.Text).Returns("<xml>OK</xml>");
        message.Setup(m => m.NMSCorrelationID).Returns("REF-123");

        // Call private method using reflection
        MethodInfo method = typeof(ActiveMQSubscribeTopic)
            .GetMethod("OnReportMessageListener", BindingFlags.NonPublic | BindingFlags.Instance);

        method.Invoke(topic, new object[] { message.Object });

        _logger.Verify(l => l.Info(It.IsAny<string>()), Times.AtLeastOnce);
    }

    // -----------------------------
    //  Attachment Message Listener Test
    // -----------------------------
    [Fact]
    public void OnAttachmentMessageListener_ShouldProcessMessage()
    {
        var topic = CreateTopic();

        var message = new Mock<ITextMessage>();
        message.Setup(m => m.Text).Returns("<xml>OK</xml>");
        message.Setup(m => m.NMSCorrelationID).Returns("ATT-456");

        MethodInfo method = typeof(ActiveMQSubscribeTopic)
            .GetMethod("OnAttachmentMessageListener", BindingFlags.NonPublic | BindingFlags.Instance);

        method.Invoke(topic, new object[] { message.Object });

        _logger.Verify(l => l.Info(It.IsAny<string>()), Times.AtLeastOnce);
    }
}
