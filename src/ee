[Fact]
public void UpdateAttachmentRecordStatus_Should_Update_All_Expected_Fields_And_DataAccess_Calls()
{
    // Arrange
    var handler = CreateHandler();

    var request = new CreateAttachmentRequest
    {
        Attachment = new AttachmentDto
        {
            AttachmentId = "10",
            LinkedAttachmentRecnum = "20",
            AttachmentRecnum = "30",
            CreatedBy = "tester"
        }
    };

    var attachmentEntity = new ATTACHMENT
    {
        ATTACHMENT_ID = "10",
        IS_DELETED = false,
        ACK_MESSAGE = null,
        LINKED_ATTACHMENT_RECNUM = null,
        ATTACHMENT_RECNUM = null
    };

    // Mock MFRDataAccess
    var dataAccessMock = new Mock<MFRDataAccess>(_parameterAccessMock.Object, _loggerMock.Object);

    dataAccessMock.Setup(x => x.GetAttachmentByRef("10"))
                  .Returns(attachmentEntity);

    dataAccessMock.Setup(x => x.UpdateAttachment(It.IsAny<ATTACHMENT>()))
                  .Verifiable();

    // Inject mock into handler (via reflection)
    typeof(AttachmentsRequestHandler)
        .GetField("_dataAccess", 
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)
        .SetValue(handler, dataAccessMock.Object);

    // Act
    InvokePrivate(handler, "UpdateAttachmentRecordStatus", request);

    // Assert – attachment fields changed correctly
    Assert.Equal("20", attachmentEntity.LINKED_ATTACHMENT_RECNUM);
    Assert.Equal("30", attachmentEntity.ATTACHMENT_RECNUM);

    // Assert – data access was called
    dataAccessMock.Verify(x => x.UpdateAttachment(It.IsAny<ATTACHMENT>()), Times.Once());
    dataAccessMock.Verify(x => x.GetAttachmentByRef("10"), Times.Once());
}
