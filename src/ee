using System.Collections.Generic;
using Xunit;
using Moq;

public class MappingFacadeTests
{
    private readonly MappingFacade _sut;

    public MappingFacadeTests()
    {
        var loggerMock = new Mock<ILogger>();
        _sut = new MappingFacade(loggerMock.Object);
    }

    [Fact]
    public void DMUTOMFRPostProcessing_WhenHeightIsSingleDigit_ShouldFormatCorrectly()
    {
        // Arrange
        var request = new AddIncidentRequest
        {
            Names = new List<IncidentName>
            {
                new IncidentName { Height = "5\"" }
            }
        };

        // Act
        _sut.DMUTOMFRPostProcessing(request);

        // Assert
        Assert.Equal("5'00\"", request.Names[0].Height);
    }

    [Fact]
    public void DMUTOMFRPostProcessing_WhenHeightHasFeetAndInches_ShouldFormatCorrectly()
    {
        // Arrange
        var request = new AddIncidentRequest
        {
            Names = new List<IncidentName>
            {
                new IncidentName { Height = "5'9\"" }
            }
        };

        // Act
        _sut.DMUTOMFRPostProcessing(request);

        // Assert
        Assert.Equal("5'09\"", request.Names[0].Height);
    }

    [Fact]
    public void DMUTOMFRPostProcessing_WhenInchesGreaterThan12_ShouldCapAt11()
    {
        // Arrange
        var request = new AddIncidentRequest
        {
            Names = new List<IncidentName>
            {
                new IncidentName { Height = "5'15\"" }
            }
        };

        // Act
        _sut.DMUTOMFRPostProcessing(request);

        // Assert
        Assert.Equal("5'11\"", request.Names[0].Height);
    }

    [Fact]
    public void DMUTOMFRPostProcessing_WhenHeightIsNull_ShouldNotThrow()
    {
        // Arrange
        var request = new AddIncidentRequest
        {
            Names = new List<IncidentName>
            {
                new IncidentName { Height = null }
            }
        };

        // Act & Assert
        var exception = Record.Exception(() =>
            _sut.DMUTOMFRPostProcessing(request));

        Assert.Null(exception);
    }
}
