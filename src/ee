using Xunit;
using Moq;
using System;
using YourNamespace;
using YourNamespace.Models; // For ACKNOWLEDGEMENT, ImportMessage, etc.

public class ProcessMFRQueueReportsTests
{
    private readonly Mock<IParameterAccess> _parameterAccessMock;
    private readonly Mock<ILogger> _loggerMock;

    public ProcessMFRQueueReportsTests()
    {
        _parameterAccessMock = new Mock<IParameterAccess>();
        _loggerMock = new Mock<ILogger>();
    }

    [Fact]
    public void ProcessQueueReports_ShouldReturn_WhenResubmissionIsEnabled()
    {
        // Arrange
        _parameterAccessMock
            .Setup(x => x.GetParameterListItem(
                ParameterConstants.MFRSet,
                ParameterList.OCRSettings,
                ParameterName.ReportResubmissionFlag))
            .Returns("true");

        var sut = new ProcessMFRQueueReports("MFR", _parameterAccessMock.Object, _loggerMock.Object);

        // Act
        sut.ProcessQueueReports();

        // Assert
        _loggerMock.Verify(x => x.Info("Report resubmission is disabled"), Times.Once);
    }

    [Fact]
    public void ProcessQueueReports_ShouldProcessReports_WhenResubmissionIsDisabled()
    {
        // Arrange
        _parameterAccessMock
            .Setup(x => x.GetParameterListItem(
                ParameterConstants.MFRSet,
                ParameterList.OCRSettings,
                ParameterName.ReportResubmissionFlag))
            .Returns("false");

        _parameterAccessMock.Setup(x => x.GetParameterListItem(ParameterConstants.MFRSet, "WebRMSUrl", "queueUrl"))
            .Returns("http://dummyQueue");
        _parameterAccessMock.Setup(x => x.GetParameterListItem(ParameterConstants.MFRSet, "WebRMSUrl", "queueName"))
            .Returns("queue1");
        _parameterAccessMock.Setup(x => x.GetParameterListItem(ParameterConstants.HFRSet, "FileDirectories", "xslDir"))
            .Returns("/temp/xsl");

        // Mocking AcknowledgementOperations behavior
        var ackMock = new Mock<AcknowledgementOperations>(_parameterAccessMock.Object, _loggerMock.Object);
        var ackRecord = new ACKNOWLEDGEMENT
        {
            RECNUM = 1,
            FORM_ID = "F001",
            HEADER_MESSAGE = "Header",
            MESSAGE_REQUEST = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes("Request"))
        };

        ackMock.SetupSequence(a => a.GetNextPendingReportForSubmissions(It.IsAny<string>()))
            .Returns(ackRecord)
            .Returns((ACKNOWLEDGEMENT)null);

        // Replace AcknowledgementOperations with mock instance (would need DI or refactoring to support directly)
        var sut = new ProcessMFRQueueReports("MFR", _parameterAccessMock.Object, _loggerMock.Object);

        // Act
        sut.ProcessQueueReports();

        // Assert
        _loggerMock.Verify(x => x.Warning(It.Is<string>(s => s.Contains("Re submitting MFR report Ref=F001"))), Times.Once);
    }

    [Fact]
    public void ProcessQueueReports_ShouldLogError_OnException()
    {
        // Arrange
        _parameterAccessMock
            .Setup(x => x.GetParameterListItem(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
            .Throws(new Exception("Parameter error"));

        var sut = new ProcessMFRQueueReports("MFR", _parameterAccessMock.Object, _loggerMock.Object);

        // Act
        sut.ProcessQueueReports();

        // Assert
        _loggerMock.Verify(x => x.Error(It.Is<string>(s => s.Contains("Error occurred while processing queue reports")), It.IsAny<Exception>()), Times.Once);
    }
}
