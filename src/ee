using Xunit;
using Moq;
using System;
using System.IO;
using System.Collections.Generic;
using System.Linq;
using Intergraph.Framework.Contracts;
using Intergraph.Framework.Logging;
using Intergraph.Framework.Localization;
using Intergraph.MFR.ApprovalsModule;

public class AttachmentsRequestHandler_HandleMessage_Tests
{
    private readonly Mock<ILogger> _logger = new();
    private readonly Mock<ILocalizedStrings> _localizedStrings = new();
    private readonly Mock<IParameterAccess> _parameterAccess = new();
    private readonly Mock<ISession> _session = new();

    private AttachmentsRequestHandler Create() =>
        new AttachmentsRequestHandler(_logger.Object, _localizedStrings.Object,
                                      _session.Object, _parameterAccess.Object);

    // Helper to force private method execution
    private object CallPrivate(object obj, string name, params object[] args)
    {
        var m = obj.GetType().GetMethod(name,
            System.Reflection.BindingFlags.Instance |
            System.Reflection.BindingFlags.NonPublic);

        return m.Invoke(obj, args);
    }

    // ---------------------------- TEST #1 ----------------------------
    [Fact]
    public void HandleMessage_AddAttachment_FullPath_Covers_All_Lines()
    {
        // Arrange
        var handler = Create();

        // Create temp folder + dummy file so foreach(file) runs
        string tempDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
        Directory.CreateDirectory(tempDir);

        string filePath = Path.Combine(tempDir, "dummy.dat");
        File.WriteAllText(filePath, "HELLO ABC");

        // Mock repository path
        _parameterAccess
            .Setup(x => x.GetParameterListItem("MFR", "Repository", "MfrCombinedChunksRepositoryLocation"))
            .Returns(tempDir);

        // Mock session → return agent code
        _session.Setup(x => x.GetValue("PrimaryAgency"))
                .Returns("AG001");

        var req = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                AttachmentId = Guid.NewGuid().ToString(),
                RequestType = AttachmentActions.AddAttachment,
                Recnum = null // MUST BE NULL → triggers AddAttachment branch
            }
        };

        var header = new MessageHeader { SessionId = "S1" };

        // Act
        var result = handler.HandleMessage(header, req);

        // Assert
        Assert.True(result.Response.Success);

        // Cleanup
        Directory.Delete(tempDir, true);
    }

    // ---------------------------- TEST #2 ----------------------------
    [Fact]
    public void HandleMessage_DeleteAttachment_Covers_Branch()
    {
        var handler = Create();

        var req = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                AttachmentId = "A1",
                RequestType = AttachmentActions.DeleteAttachment
            }
        };

        var header = new MessageHeader();

        var result = handler.HandleMessage(header, req);

        Assert.True(result.Response.Success);
    }

    // ---------------------------- TEST #3 ----------------------------
    [Fact]
    public void HandleMessage_AttachmentDeleteStatus_Covers_Branch()
    {
        var handler = Create();

        var req = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                AttachmentId = "A1",
                RequestType = AttachmentActions.AttachmentDeleteStatus
            }
        };

        var header = new MessageHeader();

        var result = handler.HandleMessage(header, req);

        Assert.True(result.Response.Success);
    }

    // ---------------------------- TEST #4 ----------------------------
    [Fact]
    public void HandleMessage_UnknownType_Covers_Warning_Branch()
    {
        var handler = Create();

        var req = new CreateAttachmentRequest
        {
            Attachment = new AttachmentDto
            {
                AttachmentId = "A1",
                RequestType = "XYZ_UNKNOWN"
            }
        };

        var header = new MessageHeader();

        var result = handler.HandleMessage(header, req);

        Assert.True(result.Response.Success);
    }

    // ---------------------------- TEST #5 ----------------------------
    [Fact]
    public void HandleMessage_Exception_Covers_Catch_Block()
    {
        var handler = Create();

        var req = new CreateAttachmentRequest
        {
            Attachment = null // FORCE NullRef inside try block
        };

        var header = new MessageHeader();

        var result = handler.HandleMessage(header, req);

        Assert.False(result.Response.Success);
        Assert.NotEmpty(result.Response.Messages);
    }
}
