// ---------------------------------------------------------------
//  LOG MESSAGE TIME  (private _logMessageTime)
// ---------------------------------------------------------------
[Fact]
public void LogMessageTime_DoesNotThrow()
{
    var client = new ImportMessageQueueClient("http://dummy");

    var method = client.GetType().GetMethod("_logMessageTime",
        BindingFlags.NonPublic | BindingFlags.Instance);

    var xml = "<root></root>";

    var ex = Record.Exception(() =>
        method.Invoke(client, new object[] { xml, DateTime.UtcNow })
    );

    Assert.Null(ex); // if it doesn't throw, it's success
}

