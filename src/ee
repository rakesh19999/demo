[Fact]
public void CheckAttachmentsFromApi_Should_Cover_All_Branches()
{
    // Arrange
    var handler = CreateHandler();
    var createResponse = new CreateAttachmentResponse();

    var request = new CreateAttachmentRequest
    {
        Attachment = new AttachmentDto
        {
            CreatedBy = "tester",
            AttachmentRecnum = "10",
            FormType = "FormA",
            FormRecnum = "100"
        }
    };

    // Mock API Response with one attachment entry
    string jsonWithAttachment =
        "{ \"result\": { \"attachments\": [{ \"attachmentRecnum\": \"10\", \"status\": \"Uploaded\" }] } }";

    var restMock = new Mock<IWebRestServiceManager>();
    restMock.Setup(x => x.GetAttachmentList("FormA", "100"))
            .Returns(jsonWithAttachment);

    // Inject mock into handler via reflection
    typeof(AttachmentsRequestHandler)
        .GetField("_restServiceManager",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)
        .SetValue(handler, restMock.Object);

    // Mock MFRDataAccess used internally
    var dataAccessMock = new Mock<MFRDataAccess>(_parameterAccessMock.Object, _loggerMock.Object);

    dataAccessMock.Setup(x => x.UpdateAttachmentStatusFromApi(It.IsAny<string>(), It.IsAny<string>()))
                  .Verifiable();

    typeof(AttachmentsRequestHandler)
       .GetField("_dataAccess",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)
       .SetValue(handler, dataAccessMock.Object);

    // Act
    InvokePrivate(handler, "CheckAttachmentsFromApi", request, createResponse);

    // Assert: API success path taken
    Assert.True(createResponse.IsSuccess);
    Assert.Equal("Uploaded", createResponse.AcknowledgementMessage);

    // Assert: Data access updated status
    dataAccessMock.Verify(x => x.UpdateAttachmentStatusFromApi("10", "Uploaded"), Times.Once());
}
