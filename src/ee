[Fact]
public void ConnectionResumedListener_Should_Log_ClientId_And_Set_IsConnected_True()
{
    var obj = CreateInstance();

    // Arrange: mock connection with ClientId
    _connectionMock.Setup(c => c.ClientId).Returns("CID-123");

    typeof(MFRActiveMQConnection)
        .GetField("_connection", BindingFlags.NonPublic | BindingFlags.Instance)
        .SetValue(obj, _connectionMock.Object);

    // Act
    var method = typeof(MFRActiveMQConnection)
        .GetMethod("Connection_ConnectionResumedListener", BindingFlags.NonPublic | BindingFlags.Instance);
    method.Invoke(obj, null);

    // Assert: logger called with message containing client id
    _logger.Verify(l => l.Info(
        It.Is<string>(s => s.Contains("Connection resumed") && s.Contains("CID-123"))
    ), Times.Once);

    bool value = (bool)typeof(MFRActiveMQConnection)
        .GetField("_isConnected", BindingFlags.NonPublic | BindingFlags.Instance)
        .GetValue(obj);

    Assert.True(value);
}
[Fact]
public void ExceptionListener_Should_Log_Error_And_Start_Timer()
{
    var obj = CreateInstance();

    // Arrange connection with clientId
    _connectionMock.Setup(c => c.ClientId).Returns("CID-ERR");
    typeof(MFRActiveMQConnection)
        .GetField("_connection", BindingFlags.NonPublic | BindingFlags.Instance)
        .SetValue(obj, _connectionMock.Object);

    var timer = (System.Timers.Timer)typeof(MFRActiveMQConnection)
        .GetField("_syncTimer", BindingFlags.NonPublic | BindingFlags.Instance)
        .GetValue(obj);

    var method = typeof(MFRActiveMQConnection)
        .GetMethod("Connection_ExceptionListener", BindingFlags.NonPublic | BindingFlags.Instance);

    // Act
    method.Invoke(obj, new object[] { new Exception("XFAIL", new Exception("INNER")) });

    // Assert 1 - logger error called
    _logger.Verify(l => l.Error(
        It.Is<string>(s => s.Contains("CID-ERR") && s.Contains("XFAIL")),
        It.IsAny<Exception>()
    ), Times.Once);

    // Assert 2 - logger info called for starting timer
    _logger.Verify(l => l.Info("Starting connection timer"), Times.Once);

    // Assert 3 - timer started
    Assert.True(timer.Enabled);

    // Assert 4 - connected flag set to false
    bool connected = (bool)typeof(MFRActiveMQConnection)
        .GetField("_isConnected", BindingFlags.NonPublic | BindingFlags.Instance)
        .GetValue(obj);

    Assert.False(connected);
}

[Fact]
public void Dispose_Should_Catch_IOException_And_Log_Error()
{
    var obj = CreateInstance();

    // Arrange - inject mock connection that throws IOException on Close()
    _connectionMock.Setup(c => c.Close())
        .Throws(new IOException("IO close fail"));

    typeof(MFRActiveMQConnection)
        .GetField("_connection", BindingFlags.NonPublic | BindingFlags.Instance)
        .SetValue(obj, _connectionMock.Object);

    // Act
    obj.Dispose();

    // Assert
    _logger.Verify(l => l.Error(
        It.Is<string>(s => s.Contains("Dispose") || s.Contains("error")),
        It.IsAny<IOException>()),
        Times.Once
    );
}
