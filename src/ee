        [Fact]
        public void ConvertActionTypeToApprovalActions_ValidAction_ReturnsEnum()
        {
            // Arrange
            var handler = CreateHandler();

            // Create a MFRApprovalRequest with a known valid ActionType string
            var request = new MFRApprovalRequest
            {
                ActionType = "StartApproval"
            };

            // Use reflection to call the private method ConvertActionTypeToApprovalActions
            var method = typeof(ApprovalsRequestHandler)
                .GetMethod("ConvertActionTypeToApprovalActions", BindingFlags.Instance | BindingFlags.NonPublic);

            Assert.NotNull(method);

            // Act
            var result = method.Invoke(handler, new object[] { request });

            // Assert - expected enum value (depends on your ApprovalActions enum naming)
            // Adjust the expected enum if your enum name differs slightly.
            Assert.Equal(ApprovalActions.StartApproval, result);
        }

        [Fact]
        public void ConvertActionTypeToApprovalActions_InvalidAction_ThrowsException()
        {
            var handler = CreateHandler();

            var request = new MFRApprovalRequest
            {
                ActionType = "NonExistentActionType"
            };

            var method = typeof(ApprovalsRequestHandler)
                .GetMethod("ConvertActionTypeToApprovalActions", BindingFlags.Instance | BindingFlags.NonPublic);

            Assert.NotNull(method);

            // Act & Assert
            var ex = Assert.Throws<TargetInvocationException>(() => method.Invoke(handler, new object[] { request }));
            // The private method throws Exception("Invalid action type specified"), wrapped by TargetInvocationException
            Assert.NotNull(ex.InnerException);
            Assert.Contains("Invalid action type", ex.InnerException.Message, StringComparison.OrdinalIgnoreCase);
        }

        [Fact]
        public void InvokeApprovalAction_StartApproval_CallsWebServiceStartApproval()
        {
            // Arrange
            var handler = CreateHandler();

            var mockService = new Mock<IWebRMSApprovalService>();

            // Set up the mock to return a sentinel object when StartApproval is called
            var expected = new { result = "started" };
            mockService
                .Setup(s => s.StartApproval(It.IsAny<object>()))
                .Returns(expected);

            // Prepare request: ensure request.Value is a JObject so ToObject<T>() will succeed inside ExecuteAction
            var request = new MFRApprovalRequest
            {
                ActionType = "StartApproval",
                Value = JObject.FromObject(new { any = "payload" })
            };

            // Act
            var result = handler.InvokeApprovalAction(request, mockService.Object);

            // Assert
            Assert.Same(expected, result);
            mockService.Verify(s => s.StartApproval(It.IsAny<object>()), Times.Once);
        }

