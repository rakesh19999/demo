import React, { FC, useEffect, useRef } from "react";
import {
  Dialog,
  DialogActions,
  DialogContent,
  DialogContentText,
  DialogTitle,
  Button
} from "@material-ui/core";
import { setFocus } from "../../CommonUI/UIElementFocusServiceWrapper";
import { getLocalizedKey } from "../../lib/Dexiebbutil";

declare const GLOBAL_BASE_URL: string;

interface UnsavedChangesDialogProps {
  open: boolean;
  headerText?: string;
  contentText?: string;
  yesText?: string;
  noText?: string;
  onYes: (e: React.MouseEvent<HTMLButtonElement>) => void;
  onNo: (e: React.MouseEvent<HTMLButtonElement>) => void;
}

export const UnsavedChangesDialog: FC<UnsavedChangesDialogProps> = ({
  open,
  headerText,
  contentText,
  yesText,
  noText,
  onYes,
  onNo
}) => {
  const yesBtnRef = useRef<HTMLButtonElement | null>(null);

  useEffect(() => {
    if (open && yesBtnRef.current) {
      setFocus(yesBtnRef.current);
    }
  }, [open]);

  return (
    <Dialog
      open={open}
      onClose={onNo}
      aria-labelledby="unsaved-dialog-title"
      aria-describedby="unsaved-dialog-description"
      fullWidth
      maxWidth="sm"
      container={document.body}
    >
      <DialogTitle id="unsaved-dialog-title">
        <img
          src={`${GLOBAL_BASE_URL}AddonViews/MFRHome/Assets/images/warning-icon.png`}
          alt="warning"
        />
        {headerText ?? "Unsaved Changes"}
      </DialogTitle>

      <DialogContent>
        <DialogContentText
          id="unsaved-dialog-description"
          style={{ color: "black" }}
        >
          {contentText ?? getLocalizedKey("DISCARD_TEXT")}
        </DialogContentText>
      </DialogContent>

      <DialogActions>
        <Button color="primary" onClick={onNo}>
          {noText ?? getLocalizedKey("CANCEL")}
        </Button>

        <Button
          color="primary"
          onClick={onYes}
          ref={yesBtnRef}
          className="hxgn-mfr_popup-yes-button"
        >
          {yesText ?? getLocalizedKey("DISCARD")}
        </Button>
      </DialogActions>
    </Dialog>
  );
};


