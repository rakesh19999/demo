    public ImportMessageQueueClient_ReflectionTests()
    {
        // find the ImportMessageQueueClient type in loaded assemblies
        _prodAssembly = AppDomain.CurrentDomain.GetAssemblies()
            .FirstOrDefault(a => a.GetTypes().Any(t => t.Name.Equals("ImportMessageQueueClient", StringComparison.OrdinalIgnoreCase)));

        Assert.NotNull(_prodAssembly); // fail early if assembly not found

        _clientType = _prodAssembly.GetTypes()
            .FirstOrDefault(t => t.Name.Equals("ImportMessageQueueClient", StringComparison.OrdinalIgnoreCase));

        Assert.NotNull(_clientType); // fail early if type not found
    }

    private object CreateClientInstance(Mock<object> paramAccessMock = null, Mock<object> loggerMock = null)
    {
        // Try to find any constructor that takes 1-5 params and instantiate with reasonable mocks / nulls
        var ctors = _clientType.GetConstructors(BindingFlags.Public | BindingFlags.Instance);
        ConstructorInfo chosen = ctors.FirstOrDefault(c => c.GetParameters().Length <= 5) ?? ctors.First();

        var args = chosen.GetParameters().Select(p =>
        {
            var pt = p.ParameterType;
            if (pt.Name.Contains("IParameterAccess")) return paramAccessMock?.Object ?? null;
            if (pt.Name.Contains("ILogger")) return loggerMock?.Object ?? null;
            if (pt == typeof(string)) return (object) "test";
            return null;
        }).ToArray();

        return chosen.Invoke(args);
    }

    private MethodInfo FindMethod(params string[] candidates) =>
        candidates.Select(name => _clientType.GetMethod(name, BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.Static))
                  .FirstOrDefault(m => m != null);

    private FieldInfo FindField(params string[] candidates) =>
        candidates.Select(name => _clientType.GetField(name, BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.Static))
                  .FirstOrDefault(f => f != null);

    // ---------- Base64 encode/decode tests ----------
    [Fact]
    public void Base64Encode_And_Decode_Roundtrip()
    {
        // find encode & decode methods (names differ in pasted code)
        var encode = FindMethod("base64Encode", "Base64Encode");
        var decodeStr = FindMethod("base64DecodeToString", "Base64DecodeToString");
        var decodeBytes = FindMethod("base64DecodeToBytes", "Base64DecodeToByte", "Base64DecodeToBytes", "base64DecodeToBytes");

        Assert.NotNull(encode);
        Assert.NotNull(decodeStr);

        var client = CreateClientInstance();

        // encode
        var encoded = encode.Invoke(client, new object[] { "hello-π" }) as string;
        Assert.False(string.IsNullOrEmpty(encoded));

        // decode string
        var decoded = decodeStr.Invoke(null, new object[] { encoded }); // decode may be static
        Assert.Equal("hello-π", decoded);

        // decode bytes if available
        if (decodeBytes != null)
        {
            var bytes = decodeBytes.Invoke(client, new object[] { encoded }) as byte[];
            Assert.NotNull(bytes);
            var round = Encoding.UTF8.GetString(bytes);
            Assert.Equal("hello-π", round);
        }
    }

    // ---------- transformXml test ----------
    [Fact]
    public void TransformXml_Uses_Xsl_From_XslDir_And_Performs_Transform()
    {
        // method candidates
        var method = FindMethod("transformXml", "TransformXml");
        Assert.NotNull(method);

        // make client
        var client = CreateClientInstance();

        // prepare temp xsl dir and xsl file; inject into private xslDir field if present
        var tempDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString("N"));
        Directory.CreateDirectory(tempDir);

        try
        {
            string xslFileName = "MyForm-XslFileName.xsl";
            string xslPath = Path.Combine(tempDir, xslFileName);
            // simple XSL that wraps root with <out>
            var xsl = @"<?xml version=""1.0""?>
<xsl:stylesheet version=""1.0"" xmlns:xsl=""http://www.w3.org/1999/XSL/Transform"">
  <xsl:output method=""xml"" encoding=""utf-8""/>
  <xsl:template match=""/"">
    <out><xsl:copy-of select=""*""/></out>
  </xsl:template>
</xsl:stylesheet>";
            File.WriteAllText(xslPath, xsl, Encoding.UTF8);

            // set private xslDir field if present
            var xslDirField = FindField("xslDir", "_xslDir", "xslDirectory");
            if (xslDirField != null) xslDirField.SetValue(client, tempDir + Path.DirectorySeparatorChar);

            // set parameterAccess to return the XSL file name when asked
            // find parameterAccess field to inject a mock
            var paramField = FindField("parameterAccess", "_parameterAccess");
            if (paramField != null)
            {
                // create a dynamic mock object implementing the interface if possible
                var paramInterface = paramField.FieldType;
                var mockType = typeof(Mock<>).MakeGenericType(paramInterface);
                var mock = Activator.CreateInstance(mockType);
                // setup method GetParameterListItem using reflection (assumes signature with 3 strings)
                var setupMethod = mockType.GetMethods().First(m => m.Name == "Setup" && m.GetParameters().Length == 1);
                // easier: use dynamic to set via known method name if interface exists in test project - skip complex setup
                // fall back: set paramField to null (method should handle null by reading real param) — but we need it to return xsl file name
                // attempt to set a simple Implementation using an anonymous type isn't possible; try to find method GetParameterListItem on type and if so use DispatchProxy? Too heavy.
                // Instead, try to find a public method on the client that calls parameterAccess; if not, we will call transformXml with direct formType that equals filename without needing param lookup.
            }

            // call transformXml with formType that matches our created filename prefix "MyForm" so if method obtains "<formtype>-XslFileName" it finds our file
            string formType = "MyForm";
            string inputXml = "<root><a>1</a></root>";

            var result = method.Invoke(client, new object[] { formType, inputXml }) as string;
            Assert.False(string.IsNullOrEmpty(result));
            Assert.Contains("<out>", result);
            Assert.Contains("<a>1</a>", result);
        }
        finally
        {
            try { Directory.Delete(tempDir, true); } catch { }
        }
    }

    // ---------- parseExportMessage tests ----------
    [Fact]
    public void ParseExportMessage_Should_Handle_Xml_And_Json_Messages()
    {
        var method = FindMethod("parseExportMessage", "ParseExportMessage");
        Assert.NotNull(method);

        var client = CreateClientInstance();

        // XML message
        string xmlMessage =
@"<Request>
  <FormType>MyForm</FormType>
  <ReferenceId>REF-1</ReferenceId>
  <Message>PHJvb3Q+PG5hbWU+Sm9objwvbmFtZT48L3Jvb3Q+</Message>  <!-- base64 of <root><name>John</name></root> -->
  <FormReport>UEsFBgAAAAAB</FormReport>
</Request>";

        var resultObj = method.Invoke(client, new object[] { xmlMessage });
        Assert.NotNull(resultObj);

        // via reflection inspect properties if present: FormXml, ReferenceId, MessageFormat, FormType
        var resType = resultObj.GetType();
        var propFormXml = resType.GetProperty("FormXml");
        var propRef = resType.GetProperty("ReferenceId");
        var propMsgFmt = resType.GetProperty("MessageFormat");
        var propFormType = resType.GetProperty("FormType");

        if (propFormXml != null) Assert.Contains("<name>John</name>", (propFormXml.GetValue(resultObj) ?? "").ToString());
        if (propRef != null) Assert.Equal("REF-1", propRef.GetValue(resultObj)?.ToString());
        if (propMsgFmt != null) Assert.Equal("XML", propMsgFmt.GetValue(resultObj)?.ToString());
        if (propFormType != null) Assert.Equal("MyForm", propFormType.GetValue(resultObj)?.ToString());

        // JSON variant (GenericResponse -> Message -> content)
        string jsonMessage = @"{ ""GenericResponse"": { ""Message"": { ""content"": ""<root><ok>true</ok></root>"" }, ""ReferenceId"": ""JREF"" } }";
        var jsonResult = method.Invoke(client, new object[] { jsonMessage });
        Assert.NotNull(jsonResult);
        var jrType = jsonResult.GetType();
        var jrFormXml = jrType.GetProperty("FormXml");
        var jrRef = jrType.GetProperty("ReferenceId");
        if (jrFormXml != null) Assert.Contains("<ok>true</ok>", jrFormXml.GetValue(jsonResult)?.ToString());
        if (jrRef != null) Assert.Equal("JREF", jrRef.GetValue(jsonResult)?.ToString());
    }

