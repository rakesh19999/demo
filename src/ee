// ------------------------ UNIT TESTS ---------------------------

public class CommandQueryTests
{
    [Fact]
    public void Constructor_ParamArray_Oracle_ExtractsParameters_And_ReplacesTokens()
    {
        // Arrange
        string query = "SELECT * FROM Users WHERE Id = @Id AND Name = @Name";

        // Act
        var cq = new CommandQuery(DatabaseTypes.Oracle, query, "10", "John");

        // Assert
        Assert.Equal(":Id", cq.CommandString.Contains(":Id") ? ":Id" : null);
        Assert.Equal(":Name", cq.CommandString.Contains(":Name") ? ":Name" : null);

        Assert.Equal("10", cq.Params["@Id"]);
        Assert.Equal("John", cq.Params["@Name"]);
    }

    [Fact]
    public void Constructor_ParamArray_SqlServer_ExtractsParams_And_FixesTokens()
    {
        string query = "SELECT * FROM Users WHERE Id = :Id";

        var cq = new CommandQuery(DatabaseTypes.SqlServer, query, "55");

        Assert.Equal("@Id", cq.CommandString.Contains("@Id") ? "@Id" : null);
        Assert.Equal("55", cq.Params[":Id"]);
    }

    [Fact]
    public void Constructor_ListConstructor_AssignsParamsCorrectly()
    {
        var parameters = new List<string> { "@A", "@B" };
        var values = new List<string> { "1", "2" };

        var cq = new CommandQuery(DatabaseTypes.SqlServer, "test :A :B", parameters, values);

        Assert.Equal("1", cq.Params["@A"]);
        Assert.Equal("2", cq.Params["@B"]);
    }

    [Fact]
    public void Constructor_DictionaryConstructor_Oracle_ReplacesTokens()
    {
        var dict = new Dictionary<string, string>
        {
            { "@X", "100" }
        };

        var cq = new CommandQuery(DatabaseTypes.Oracle, "SELECT * FROM T WHERE X = @X", dict);

        Assert.Equal(":X", cq.CommandString.Contains(":X") ? ":X" : null);
    }

    [Fact]
    public void Initialize_ThrowsException_When_ParameterCountMismatch()
    {
        var parameters = new List<string> { "@Id" };
        var values = new List<string> { "100", "ExtraValue" };

        Assert.Throws<Exception>(() => new CommandQuery(DatabaseTypes.SqlServer, "SELECT", parameters, values));
    }
}
