export const handleArrestBookingConfiguration = (
  stateInfo: any,
  sectionType: string | undefined,
  action: any,
  propertyKey?: string
) => {
  try {
    // 1️⃣ Resolve section deterministically
    const sessionSection =
      getSessionStorageFor(
        HignHFRStorageConstants.wfrCurrentReportSection
      )?.trim();

    const currentSectionType =
      sectionType?.trim() ||
      action?.meta?.sectionType?.trim() ||
      sessionSection;

    if (!currentSectionType) {
      return stateInfo;
    }

    // 2️⃣ Safely read sections (DEV may send null)
    const stateSection = stateInfo?.[currentSectionType] ?? {};
    const payloadSection = action?.payload?.[currentSectionType] ?? {};

    // 3️⃣ Compute booking flags ONCE
    const bookingDisabled = Boolean(isBookingDisabled(action));
    const bookingButtonDisabled = Boolean(
      isBookingDisabled(action, true)
    );

    // 4️⃣ Build updated section (NO DATA LOSS)
    let updatedSection = {
      ...stateSection,
      ...payloadSection,
      [RequestKeyConstant.isBookingDisabled]: bookingDisabled,
      [RequestKeyConstant.isBookingButtonDisabled]:
        bookingButtonDisabled,
    };

    // 5️⃣ Booking status logic (SAFE + FIXED)
    if (currentSectionType === RequestKeyConstant.arrestBooking) {
      const isActive =
        stateSection?.[RequestKeyConstant.active] ||
        payloadSection?.[RequestKeyConstant.bookingStatus] ===
          RequestKeyConstant.activeBooking;

      updatedSection = {
        ...updatedSection,
        [RequestKeyConstant.bookingStatus]: isActive
          ? RequestKeyConstant.activeBooking
          : RequestKeyConstant.preBooking,
      };
    }

    // 6️⃣ DOB → Juvenile logic (GUARDED)
    if (propertyKey === RequestKeyConstant.dob) {
      const selectedDate =
        payloadSection?.[RequestKeyConstant.wfrArresteesNames]?.[
          RequestKeyConstant.dob
        ];

      const arrestDate = payloadSection?.arrestDate;
      const juvenileAge = action?.extraPayload;

      if (selectedDate && arrestDate && juvenileAge != null) {
        const age = moment(arrestDate).diff(
          moment(selectedDate),
          "years"
        );

        updatedSection = {
          ...updatedSection,
          [RequestKeyConstant.wfrArresteesNames]: {
            ...updatedSection[
              RequestKeyConstant.wfrArresteesNames
            ],
            [RequestKeyConstant.afrJuvenile]:
              age < juvenileAge,
          },
        };
      }
    }

    // 7️⃣ Return final merged state
    return {
      ...stateInfo,
      [currentSectionType]: updatedSection,
    };
  } catch (err) {
    console.error(
      "Error occurred in handleArrestBookingConfiguration",
      err
    );
    return stateInfo;
  }
};
