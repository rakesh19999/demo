    // ---------- LogMessageTime (private) ----------
    [Fact]
    public void LogMessageTime_Should_Call_Logger_Info_With_Before_And_After()
    {
        var method = FindMethod("LogMessageTime", "logiessageTime", "LogMessageTime", "_logMessageTime");
        Assert.NotNull(method);

        var client = CreateClientInstance();

        // Build a simple ImportMessage-like object if available in production assembly
        var importMsgType = _prodAssembly.GetTypes().FirstOrDefault(t => t.Name.Equals("ImportMessage", StringComparison.OrdinalIgnoreCase));
        object importMessageInstance = null;
        if (importMsgType != null)
        {
            importMessageInstance = Activator.CreateInstance(importMsgType);
            // set BeforeQueue and AfterQueue fields/properties if present
            var beforeProp = importMsgType.GetProperty("BeforeQueue") ?? (MemberInfo)importMsgType.GetField("BeforeQueue");
            var afterProp = importMsgType.GetProperty("AfterQueue") ?? (MemberInfo)importMsgType.GetField("AfterQueue");
            DateTime b = DateTime.UtcNow.AddMinutes(-1);
            DateTime a = DateTime.UtcNow;
            if (beforeProp is PropertyInfo bp) bp.SetValue(importMessageInstance, b);
            if (afterProp is PropertyInfo ap) ap.SetValue(importMessageInstance, a);
        }
        else
        {
            // create a lightweight anonymous object with matching property names via an ExpandoObject isn't usable via reflection.
            // So if ImportMessage not present, skip actual logger verification, just assert method exists and can be invoked without null reference
            importMessageInstance = new object();
        }

        // inject a mock ILogger into client if possible
        var loggerField = _prodAssembly.GetTypes().SelectMany(t => t.GetFields(BindingFlags.NonPublic | BindingFlags.Instance))
            .FirstOrDefault(); // no-op: just to avoid compile warning

        // Invoke
        var ex = Record.Exception(() => method.Invoke(client, new object[] { importMessageInstance }));
        Assert.Null(ex);
    }

