public class ProcessMFRQueueReports
{
    private readonly string _moduleName;
    private readonly ILogger _logger;
    private readonly IParameterAccess _parameterAccess;

    public ProcessMFRQueueReports(string moduleName, IParameterAccess parameterAccess, ILogger logger)
    {
        _moduleName = moduleName;
        _logger = logger;
        _parameterAccess = parameterAccess;
    }

    public virtual void ProcessQueueReports()
    {
        try
        {
            string reportResubmissionFlagStr = _parameterAccess?
                .GetParameterListItem(ParameterConstants.MFRSet, ParameterList.OCRSettings, ParameterName.ReportResubmissionFlag);

            bool isReportResubmissionEnable = false;
            bool.TryParse(reportResubmissionFlagStr, out isReportResubmissionEnable);

            if (isReportResubmissionEnable)
            {
                _logger.Info("Report resubmission is disabled");
                return;
            }

            var acknowledgementOperations = new AcknowledgementOperations(_parameterAccess, _logger);
            string queueUrl = _parameterAccess?.GetParameterListItem(ParameterConstants.MFRSet, "WebRMSUrl", "queueUrl");
            string queueName = _parameterAccess?.GetParameterListItem(ParameterConstants.MFRSet, "WebRMSUrl", "queueName");
            string xslDir = _parameterAccess?.GetParameterListItem(ParameterConstants.HFRSet, "FileDirectories", "xslDir");

            var queueClient = new ImportMessageQueueClient(queueUrl, queueName, xslDir, _parameterAccess, _logger);
            var queueAcknowledgementRecord = acknowledgementOperations.GetNextPendingReportForSubmissions(_moduleName);

            while (queueAcknowledgementRecord != null)
            {
                var importMessage = new ImportMessage();

                try
                {
                    acknowledgementOperations.LockReportForSubmission(queueAcknowledgementRecord.RECNUM);

                    importMessage.ReferenceId = queueAcknowledgementRecord.FORM_ID;
                    importMessage.HeaderMessage = queueAcknowledgementRecord.HEADER_MESSAGE;
                    importMessage.MessageRequest = new ObjectToStringConverter(_logger)
                        .ToStringFromBase64String(queueAcknowledgementRecord.MESSAGE_REQUEST);

                    _logger.Warning($"Re submitting {_moduleName} report Ref={importMessage.ReferenceId}");
                    queueClient.SendMessageToQueue(importMessage);
                }
                finally
                {
                    acknowledgementOperations.UpdateReportSubmissionStatus(importMessage);
                    queueAcknowledgementRecord = acknowledgementOperations.GetNextPendingReportForSubmissions(_moduleName);
                }
            }
        }
        catch (Exception ex)
        {
            _logger.Error($"Error occurred while processing queue reports for {_moduleName}", ex);
        }
    }
}
