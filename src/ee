it("should re-run effect when recnum changes", () => {
  const spy = jest.spyOn(require("react-redux"), "useSelector");

  spy
    .mockImplementationOnce((selector) =>
      selector({
        metaDataState: {
          queriesSearchCriteria: {
            agency: { recnum: "123" },
          },
        },
      })
    )
    .mockImplementationOnce((selector) =>
      selector({
        metaDataState: {
          queriesSearchCriteria: {
            agency: { recnum: "456" },
          },
        },
      })
    );

  const mockSetOptions = jest.fn();

  const { rerender } = render(
    <YourComponent
      handleCustomOptionsSelect={() => []}
      getSelectOptions={jest.fn()}
      setoptions={mockSetOptions}
      id="test"
      isMyqueryField={true}
    />
  );

  rerender(
    <YourComponent
      handleCustomOptionsSelect={() => []}
      getSelectOptions={jest.fn()}
      setoptions={mockSetOptions}
      id="test"
      isMyqueryField={true}
    />
  );

  expect(mockSetOptions).toHaveBeenCalledTimes(2);
});
