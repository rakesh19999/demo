using Xunit;
using Moq;
using System.Linq;
using System.ServiceModel;
using System.ServiceModel.Channels;
using System.ServiceModel.Description;
using System.ServiceModel.Dispatcher;
using Intergraph.Cad.Infrastructure;
using OnCall.MFRSessionNotificationsModule;

namespace OnCall.MFRSessionNotificationsModule.Tests
{
    public class InspectorBehaviorTests
    {
        private readonly Mock<ILogger> _loggerMock;

        public InspectorBehaviorTests()
        {
            _loggerMock = new Mock<ILogger>();
        }

        #region InspectorBehavior tests

        [Fact]
        public void AddBindingParameters_LogsInformation()
        {
            // Arrange
            var behavior = new InspectorBehavior(
                _loggerMock.Object,
                "appId",
                "appToken");

            var endpoint = new ServiceEndpoint(
                ContractDescription.GetContract(typeof(IDisposable)));

            var bindingParameters = new BindingParameterCollection();

            // Act
            behavior.AddBindingParameters(endpoint, bindingParameters);

            // Assert
            _loggerMock.Verify(
                x => x.Info(It.Is<string>(s => s.Contains("AddBindingParameters"))),
                Times.Once);
        }

        [Fact]
        public void ApplyClientBehavior_AddsMessageInspector()
        {
            // Arrange
            var behavior = new InspectorBehavior(
                _loggerMock.Object,
                "appId",
                "appToken");

            var endpoint = new ServiceEndpoint(
                ContractDescription.GetContract(typeof(IDisposable)));

            var clientRuntime = new ClientRuntime("test", "contract");

            // Act
            behavior.ApplyClientBehavior(endpoint, clientRuntime);

            // Assert
            Assert.Single(clientRuntime.ClientMessageInspectors);
            Assert.IsType<MessageInspector>(
                clientRuntime.ClientMessageInspectors.First());
        }

        [Fact]
        public void ApplyDispatchBehavior_LogsInformation()
        {
            // Arrange
            var behavior = new InspectorBehavior(
                _loggerMock.Object,
                "appId",
                "appToken");

            var endpoint = new ServiceEndpoint(
                ContractDescription.GetContract(typeof(IDisposable)));

            var endpointDispatcher = new EndpointDispatcher(
                new EndpointAddress("http://localhost/test"),
                "contract",
                "namespace");

            // Act
            behavior.ApplyDispatchBehavior(endpoint, endpointDispatcher);

            // Assert
            _loggerMock.Verify(
                x => x.Info(It.Is<string>(s => s.Contains("ApplyDispatchBehavior"))),
                Times.Once);
        }

        [Fact]
        public void Validate_LogsInformation()
        {
            // Arrange
            var behavior = new InspectorBehavior(
                _loggerMock.Object,
                "appId",
                "appToken");

            var endpoint = new ServiceEndpoint(
                ContractDescription.GetContract(typeof(IDisposable)));

            // Act
            behavior.Validate(endpoint);

            // Assert
            _loggerMock.Verify(
                x => x.Info(It.Is<string>(s => s.Contains("Validate"))),
                Times.Once);
        }

        #endregion

        #region MessageInspector tests

        [Fact]
        public void BeforeSendRequest_AddsHttpHeaders()
        {
            // Arrange
            var inspector = new MessageInspector(
                _loggerMock.Object,
                "appId123",
                "token456");

            var request = Message.CreateMessage(
                MessageVersion.Soap11,
                "urn:test");

            var channelMock = new Mock<IClientChannel>();

            // Act
            inspector.BeforeSendRequest(ref request, channelMock.Object);

            // Assert
            Assert.True(
                request.Properties.ContainsKey(HttpRequestMessageProperty.Name));

            var httpProperty =
                request.Properties[HttpRequestMessageProperty.Name]
                as HttpRequestMessageProperty;

            Assert.NotNull(httpProperty);
            Assert.Equal("appId123", httpProperty.Headers["AppID"]);
            Assert.Equal("token456", httpProperty.Headers["AppToken"]);
        }

        [Fact]
        public void AfterReceiveReply_LogsInformation()
        {
            // Arrange
            var inspector = new MessageInspector(
                _loggerMock.Object,
                "appId",
                "token");

            var reply = Message.CreateMessage(
                MessageVersion.Soap11,
                "urn:test");

            object correlationState = null;

            // Act
            inspector.AfterReceiveReply(ref reply, correlationState);

            // Assert
            _loggerMock.Verify(
                x => x.Info(It.Is<string>(s => s.Contains("AfterReceiveReply"))),
                Times.Once);
        }

        #endregion
    }
}
