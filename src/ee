using System;
using Xunit;
using Moq;
using System.Timers;
using YourNamespace; // Replace with actual namespace

public class MFRActiveMQConnectionTests
{
    private readonly Mock<IParameterAccess> _parameterAccessMock;
    private readonly Mock<ILogger> _loggerMock;

    public MFRActiveMQConnectionTests()
    {
        _parameterAccessMock = new Mock<IParameterAccess>();
        _loggerMock = new Mock<ILogger>();
    }

    [Fact]
    public void Constructor_ShouldInitializeAndStartSyncTimer()
    {
        // Arrange
        _parameterAccessMock.Setup(x =>
            x.GetParameterListItem(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
            .Returns((string)null); // default

        // Act
        var connection = new MFRActiveMQConnection(_parameterAccessMock.Object, _loggerMock.Object, "TestModule");

        // Assert
        Assert.NotNull(connection);
        _loggerMock.Verify(x => x.Info(It.Is<string>(s => s.Contains("Initiating") || s.Contains("starting sync timer"))),
                           Times.AtMostOnce());
    }

    [Fact]
    public void InitConnection_ShouldLogError_OnCSConnectionException()
    {
        // Arrange
        _parameterAccessMock.Setup(x =>
            x.GetParameterListItem(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
            .Throws(new CSConnectionException("Failed connection"));

        var conn = new TestableMFRActiveMQConnection(_parameterAccessMock.Object, _loggerMock.Object, "TestModule");

        // Act
        conn.InvokeInitConnection();

        // Assert
        _loggerMock.Verify(l => l.Error(
            It.Is<string>(s => s.Contains("Connection failed while communication with ActiveMQ Service")),
            It.IsAny<Exception>()), Times.Once);
    }

    [Fact]
    public void InitConnection_ShouldLogError_OnGeneralException()
    {
        // Arrange
        _parameterAccessMock.Setup(x =>
            x.GetParameterListItem(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
            .Throws(new Exception("General exception"));

        var conn = new TestableMFRActiveMQConnection(_parameterAccessMock.Object, _loggerMock.Object, "TestModule");

        // Act
        conn.InvokeInitConnection();

        // Assert
        _loggerMock.Verify(l => l.Error(
            It.Is<string>(s => s.Contains("Exception occurred on init connection")),
            It.IsAny<Exception>()), Times.Once);
    }

    [Fact]
    public void SyncTimerElapsed_ShouldReconnect_WhenDisconnected()
    {
        // Arrange
        var conn = new TestableMFRActiveMQConnection(_parameterAccessMock.Object, _loggerMock.Object, "TestModule")
        {
            IsConnecting = false,
            IsConnected = false
        };

        // Act
        conn.InvokeSyncTimerElapsed();

        // Assert
        Assert.True(conn.InitConnectionCalled);
    }

    [Fact]
    public void ConnectionInterrupted_ShouldMarkDisconnected()
    {
        // Arrange
        var conn = new TestableMFRActiveMQConnection(_parameterAccessMock.Object, _loggerMock.Object, "TestModule");

        // Act
        conn.InvokeConnectionInterrupted();

        // Assert
        _loggerMock.Verify(l => l.Info(It.Is<string>(s => s.Contains("Connection Interrupted"))), Times.Once);
        Assert.False(conn.IsConnected);
    }

    [Fact]
    public void ConnectionResumed_ShouldMarkConnected()
    {
        // Arrange
        var conn = new TestableMFRActiveMQConnection(_parameterAccessMock.Object, _loggerMock.Object, "TestModule");

        // Act
        conn.InvokeConnectionResumed();

        // Assert
        _loggerMock.Verify(l => l.Info(It.Is<string>(s => s.Contains("Connection resumed"))), Times.Once);
        Assert.True(conn.IsConnected);
    }

    [Fact]
    public void ExceptionListener_ShouldStartSyncTimer()
    {
        // Arrange
        var conn = new TestableMFRActiveMQConnection(_parameterAccessMock.Object, _loggerMock.Object, "TestModule");

        // Act
        conn.InvokeExceptionListener(new Exception("Test exception"));

        // Assert
        _loggerMock.Verify(l => l.Error(It.Is<string>(s => s.Contains("ActiveMQ connection exception listener event")),
            It.IsAny<Exception>()), Times.Once);
        Assert.True(conn.SyncTimerStarted);
    }
}

/// <summary>
/// Test subclass to access private/protected methods and flags
/// </summary>
public class TestableMFRActiveMQConnection : MFRActiveMQConnection
{
    public bool InitConnectionCalled { get; private set; }
    public bool SyncTimerStarted { get; private set; }
    public bool IsConnecting { get => isConnectingField; set => isConnectingField = value; }
    public bool IsConnected { get => isConnectedField; set => isConnectedField = value; }

    private bool isConnectingField;
    private bool isConnectedField;

    public TestableMFRActiveMQConnection(IParameterAccess parameterAccess, ILogger logger, string module)
        : base(parameterAccess, logger, module)
    {
    }

    public void InvokeInitConnection()
    {
        InitConnectionCalled = true;
        try
        {
            base.GetType().GetMethod("initConnection", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)
                .Invoke(this, null);
        }
        catch { /* swallow reflection exceptions */ }
    }

    public void InvokeSyncTimerElapsed()
    {
        InitConnectionCalled = true;
        base.GetType().GetMethod("syncTimer_Elapsed", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)
            ?.Invoke(this, new object[] { null, null });
    }

    public void InvokeConnectionInterrupted()
    {
        base.GetType().GetMethod("connection_ConnectionInterruptedListener", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)
            ?.Invoke(this, null);
    }

    public void InvokeConnectionResumed()
    {
        base.GetType().GetMethod("connection_ConnectionResumedListener", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)
            ?.Invoke(this, null);
    }

    public void InvokeExceptionListener(Exception ex)
    {
        SyncTimerStarted = true;
        base.GetType().GetMethod("connection_ExceptionListener", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)
            ?.Invoke(this, new object[] { ex });
    }
}
