public class IncidentCommandModuleTests
{
    private readonly Mock<IWebRestServiceManager> _mockRestService;
    private readonly Mock<XMLProcessor> _mockXmlProcessor;
    private readonly ILogger _logger;
    private readonly IParameterAccess _parameterAccess;

    public IncidentCommandModuleTests()
    {
        _mockRestService = new Mock<IWebRestServiceManager>();
        _mockXmlProcessor = new Mock<XMLProcessor>(_parameterAccess, _logger);
    }

    [Fact]
    public void Initialize_ShouldSetRabbitMq_WhenServiceReturnsTrue()
    {
        // Arrange
        _mockRestService.Setup(x => x.checkIsRabbitMQ()).Returns(true);

        var sut = new TestableIncidentCommandModule(
            baseServices,
            _logger,
            _parameterAccess,
            _mockRestService.Object,
            _mockXmlProcessor.Object
        );

        // Act
        sut.Initialize();

        // Assert
        bool isRabbitMq =
            TestHelper.GetPrivateField<bool>(sut, "isRabbitMq");

        Assert.True(isRabbitMq);
    }
}

/* ============================
   Test-only subclass
   ============================ */
internal class TestableIncidentCommandModule : IncidentCommandModule
{
    private readonly IWebRestServiceManager _restService;
    private readonly XMLProcessor _xmlProcessor;

    public TestableIncidentCommandModule(
        BaseServices baseServices,
        ILogger logger,
        IParameterAccess parameterAccess,
        IWebRestServiceManager restService,
        XMLProcessor xmlProcessor)
        : base(baseServices, logger, parameterAccess)
    {
        _restService = restService;
        _xmlProcessor = xmlProcessor;
    }

    protected override IWebRestServiceManager CreateRestService(string user)
        => _restService;

    protected override XMLProcessor CreateXmlProcessor()
        => _xmlProcessor;
}
