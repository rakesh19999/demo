        [Fact]
        public void ExecuteAction_ClaimsAndOtherActions_InvokeCorrectServiceMethods()
        {
            var handler = CreateHandler();
            var mockService = new Mock<IWebRMSApprovalService>();

            mockService.Setup(s => s.Claim(It.IsAny<object>())).Returns("claimed");
            mockService.Setup(s => s.UnClaim(It.IsAny<object>())).Returns("unclaimed");
            mockService.Setup(s => s.Redirect(It.IsAny<object>())).Returns("redirected");
            mockService.Setup(s => s.Reject(It.IsAny<object>())).Returns("rejected");

            var claimRequest = new MFRApprovalRequest { ActionType = "Claim", Value = JObject.FromObject(new { id = 1 }) };
            var unClaimRequest = new MFRApprovalRequest { ActionType = "UnClaim", Value = JObject.FromObject(new { id = 2 }) };
            var redirectRequest = new MFRApprovalRequest { ActionType = "Redirect", Value = JObject.FromObject(new { id = 3 }) };
            var rejectRequest = new MFRApprovalRequest { ActionType = "Reject", Value = JObject.FromObject(new { id = 4 }) };

            Assert.Equal("claimed", handler.InvokeApprovalAction(claimRequest, mockService.Object));
            Assert.Equal("unclaimed", handler.InvokeApprovalAction(unClaimRequest, mockService.Object));
            Assert.Equal("redirected", handler.InvokeApprovalAction(redirectRequest, mockService.Object));
            Assert.Equal("rejected", handler.InvokeApprovalAction(rejectRequest, mockService.Object));

            mockService.Verify(s => s.Claim(It.IsAny<object>()), Times.Once);
            mockService.Verify(s => s.UnClaim(It.IsAny<object>()), Times.Once);
            mockService.Verify(s => s.Redirect(It.IsAny<object>()), Times.Once);
            mockService.Verify(s => s.Reject(It.IsAny<object>()), Times.Once);
        }

        [Fact]
        public void HandleMessage_OnInvalidAction_CatchesExceptionAndReturnsFailureResponse()
        {
            // This test triggers the handler's exception branch by giving an invalid action type.
            var handler = CreateHandler();

            var header = new MessageHeader
            {
                // Set simple fields used by code; adjust names if your MessageHeader differs
                SessionId = Guid.NewGuid().ToString()
            };

            // Create a request that will cause ConvertActionTypeToApprovalActions to throw when called
            var request = new MFRApprovalRequest
            {
                ActionType = "InvalidActionThatWillNotParse",
                Value = new JObject()
            };

            // Act
            var messageResponse = handler.HandleMessage(header, request);

            // Assert: as per your catch block, response.Success should be false and an error message should be present
            Assert.NotNull(messageResponse);
            // The returned MessageResponse contains the handler response object which in your code was built from Response
            // Inspecting internals depends on your MessageResponse implementation; try to access the contained response object:
            var responseProperty = messageResponse.GetType().GetProperty("Response", BindingFlags.Public | BindingFlags.Instance)
                                   ?? messageResponse.GetType().GetProperty("response", BindingFlags.Public | BindingFlags.Instance);

            if (responseProperty != null)
            {
                var responseObj = responseProperty.GetValue(messageResponse);
                if (responseObj != null)
                {
                    // try to read 'Success' property on response object
                    var successProp = responseObj.GetType().GetProperty("Success", BindingFlags.Public | BindingFlags.Instance);
                    if (successProp != null)
                    {
                        var successVal = (bool)successProp.GetValue(responseObj)!;
                        Assert.False(successVal, "Expected handler to return a failure Response when InvokeApprovalAction throws.");
                    }

                    // try to read Messages collection
                    var messagesProp = responseObj.GetType().GetProperty("Messages", BindingFlags.Public | BindingFlags.Instance);
                    if (messagesProp != null)
                    {
                        var messages = messagesProp.GetValue(responseObj) as System.Collections.IEnumerable;
                        Assert.NotNull(messages);
                        // Ensure that there is at least one message mentioning 'Error occured' added by your catch block
                        var found = false;
                        foreach (var m in messages!)
                        {
                            if (m != null && m.ToString().Contains("Error occured", StringComparison.OrdinalIgnoreCase))
                            {
                                found = true;
                                break;
                            }
                        }
                        Assert.True(found, "Expected the response messages to contain the handler error text.");
                    }
                }
            }

            // Also check the returned messageResponse object to ensure the payload's Data or IsSuccess reflect failure.
            var payloadProp = messageResponse.GetType().GetProperty("Payload", BindingFlags.Public | BindingFlags.Instance)
                              ?? messageResponse.GetType().GetProperty("payload", BindingFlags.Public | BindingFlags.Instance);

            if (payloadProp != null)
            {
                var payload = payloadProp.GetValue(messageResponse);
                if (payload != null)
                {
                    // Try to get 'IsSuccess' or 'ErrorMessage' fields if present on payload
                    var isSuccessProp = payload.GetType().GetProperty("IsSuccess", BindingFlags.Public | BindingFlags.Instance);
                    if (isSuccessProp != null)
                    {
                        var isSuccessVal = (bool)isSuccessProp.GetValue(payload)!;
                        Assert.False(isSuccessVal);
                    }

                    var errMsgProp = payload.GetType().GetProperty("ErrorMessage", BindingFlags.Public | BindingFlags.Instance);
                    if (errMsgProp != null)
                    {
                        var err = errMsgProp.GetValue(payload) as string;
                        Assert.NotNull(err);
                        Assert.NotEmpty(err);
                    }
                }
            }
        }
