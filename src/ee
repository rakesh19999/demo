using Xunit;
using Moq;
using Apache.NMS;
using System;
using System.Reflection;

// ---------------------------
// Test-friendly subclass
// ---------------------------
public class FakeActiveMQSubscribeTopic : ActiveMQSubscribeTopic
{
    public FakeActiveMQSubscribeTopic(
        string topicName,
        string brokerUri,
        string outputDir,
        AcknowledgementMode ack,
        IParameterAccess parameters,
        ILogger logger)
        : base(topicName, brokerUri, outputDir, ack, parameters, logger)
    {
    }

    // Override InitConnection so real code is not executed
    protected override void InitConnection()
    {
        // Do nothing — prevents original constructor logic
    }
}

// ---------------------------
// UNIT TESTS
// ---------------------------
public class ActiveMQSubscribeTopicTests
{
    private Mock<IParameterAccess> _param;
    private Mock<ILogger> _logger;
    private Mock<IConnectionFactory> _factory;
    private Mock<IConnection> _connection;
    private Mock<ISession> _session;
    private Mock<IMessageConsumer> _consumer;

    public ActiveMQSubscribeTopicTests()
    {
        _param = new Mock<IParameterAccess>();
        _logger = new Mock<ILogger>();
        _factory = new Mock<IConnectionFactory>();
        _connection = new Mock<IConnection>();
        _session = new Mock<ISession>();
        _consumer = new Mock<IMessageConsumer>();
    }

    private FakeActiveMQSubscribeTopic CreateTestInstance()
    {
        _param.Setup(x => x.GetParameterListItem(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
              .Returns("TestTopic");

        // Instantiate subclass where InitConnection() is not executed
        var instance = new FakeActiveMQSubscribeTopic(
            "TestTopic",
            "tcp://localhost:61616",
            "C:\\Output",
            AcknowledgementMode.AutoAcknowledge,
            _param.Object,
            _logger.Object
        );

        // Inject mocks using reflection
        typeof(ActiveMQSubscribeTopic)
            .GetField("connectionFactory", BindingFlags.NonPublic | BindingFlags.Instance)
            .SetValue(instance, _factory.Object);

        typeof(ActiveMQSubscribeTopic)
            .GetField("connection", BindingFlags.NonPublic | BindingFlags.Instance)
            .SetValue(instance, _connection.Object);

        typeof(ActiveMQSubscribeTopic)
            .GetField("session", BindingFlags.NonPublic | BindingFlags.Instance)
            .SetValue(instance, _session.Object);

        typeof(ActiveMQSubscribeTopic)
            .GetField("consumer", BindingFlags.NonPublic | BindingFlags.Instance)
            .SetValue(instance, _consumer.Object);

        return instance;
    }

    // -----------------------------
    // Test Dispose
    // -----------------------------
    [Fact]
    public void Dispose_ShouldCall_Close_OnAllResources()
    {
        var instance = CreateTestInstance();

        instance.Dispose();

        _consumer.Verify(c => c.Close(), Times.Once);
        _session.Verify(s => s.Close(), Times.Once);
        _connection.Verify(c => c.Close(), Times.Once);
    }

    // -----------------------------
    // Test OnReportMessageListener
    // -----------------------------
    [Fact]
    public void OnReportMessageListener_ShouldLogAcknowledgement()
    {
        var instance = CreateTestInstance();

        var msg = new Mock<ITextMessage>();
        msg.Setup(m => m.Text).Returns("<xml>OK</xml>");
        msg.Setup(m => m.NMSCorrelationID).Returns("REF123");

        MethodInfo method = typeof(ActiveMQSubscribeTopic)
            .GetMethod("OnReportMessageListener", BindingFlags.NonPublic | BindingFlags.Instance);

        method.Invoke(instance, new object[] { msg.Object });

        _logger.Verify(l => l.Info(It.IsAny<string>()), Times.AtLeastOnce);
    }

    // -----------------------------
    // Test OnAttachmentMessageListener
    // -----------------------------
    [Fact]
    public void OnAttachmentMessageListener_ShouldLogInfoOrWarning()
    {
        var instance = CreateTestInstance();

        var msg = new Mock<ITextMessage>();
        msg.Setup(m => m.Text).Returns("<xml>OK</xml>");
        msg.Setup(m => m.NMSCorrelationID).Returns("ATT123");

        MethodInfo method = typeof(ActiveMQSubscribeTopic)
            .GetMethod("OnAttachmentMessageListener", BindingFlags.NonPublic | BindingFlags.Instance);

        method.Invoke(instance, new object[] { msg.Object });

        _logger.Verify(l => l.Info(It.IsAny<string>()), Times.AtLeastOnce);
    }
}
