using Xunit;
using Moq;
using Apache.NMS;
using Microsoft.Extensions.Logging;
using System;
using Intergraph.HFR.ApprovalsModule; // adjust namespace
using static Intergraph.HFR.ApprovalsModule.ParameterConstants;

public class ActiveMQSubscribeTopicTests
{
    private readonly Mock<IParameterAccess> _mockParameterAccess;
    private readonly Mock<ILogger> _mockLogger;
    private readonly Mock<IConnectionFactory> _mockConnectionFactory;
    private readonly Mock<IConnection> _mockConnection;
    private readonly Mock<ISession> _mockSession;
    private readonly Mock<IMessageConsumer> _mockConsumer;

    public ActiveMQSubscribeTopicTests()
    {
        _mockParameterAccess = new Mock<IParameterAccess>();
        _mockLogger = new Mock<ILogger>();
        _mockConnectionFactory = new Mock<IConnectionFactory>();
        _mockConnection = new Mock<IConnection>();
        _mockSession = new Mock<ISession>();
        _mockConsumer = new Mock<IMessageConsumer>();

        _mockConnectionFactory
            .Setup(x => x.CreateConnection())
            .Returns(_mockConnection.Object);

        _mockConnection
            .Setup(x => x.CreateSession(It.IsAny<AcknowledgementMode>()))
            .Returns(_mockSession.Object);

        _mockSession
            .Setup(x => x.CreateConsumer(It.IsAny<IDestination>(), null))
            .Returns(_mockConsumer.Object);
    }

    [Fact]
    public void InitConnection_ShouldCreateConnectionAndConsumer()
    {
        // Arrange
        var topicName = "TestTopic";
        var brokerUri = "tcp://localhost:61616";
        var outputDir = "C:\\Output";
        var ackMode = AcknowledgementMode.AutoAcknowledge;

        _mockParameterAccess
            .Setup(x => x.GetParameterListItem(MFRSet, ParameterList.AlertSettings, ParameterName.AlertsTopicName))
            .Returns("AnotherTopic");

        var sut = new ActiveMQSubscribeTopic(topicName, brokerUri, outputDir, ackMode, _mockParameterAccess.Object, _mockLogger.Object);

        // Act
        var consumer = sut.GetConsumer();

        // Assert
        Assert.NotNull(consumer);
    }

    [Fact]
    public void GetConsumer_ShouldReturnConsumerInstance()
    {
        // Arrange
        var topicName = "SampleTopic";
        var brokerUri = "tcp://localhost:61616";
        var sut = new ActiveMQSubscribeTopic(topicName, brokerUri, "C:\\Output", AcknowledgementMode.ClientAcknowledge, _mockParameterAccess.Object, _mockLogger.Object);

        // Act
        var consumer = sut.GetConsumer();

        // Assert
        Assert.NotNull(consumer);
    }

    [Fact]
    public void OnReportMessageListener_ShouldThrow_WhenMessageIsNull()
    {
        // Arrange
        var sut = new ActiveMQSubscribeTopic("topic", "uri", "dir", AcknowledgementMode.AutoAcknowledge, _mockParameterAccess.Object, _mockLogger.Object);

        // Act & Assert
        Assert.Throws<ArgumentNullException>(() =>
        {
            var onReportMessageListenerMethod = typeof(ActiveMQSubscribeTopic)
                .GetMethod("OnReportMessageListener", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            onReportMessageListenerMethod.Invoke(sut, new object[] { null });
        });
    }

    [Fact]
    public void Dispose_ShouldCleanUpResources()
    {
        // Arrange
        var sut = new ActiveMQSubscribeTopic("topic", "uri", "dir", AcknowledgementMode.AutoAcknowledge, _mockParameterAccess.Object, _mockLogger.Object);

        // Mock the internal fields via reflection if necessary
        var consumerField = typeof(ActiveMQSubscribeTopic).GetField("consumer", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        consumerField.SetValue(sut, _mockConsumer.Object);

        var sessionField = typeof(ActiveMQSubscribeTopic).GetField("session", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        sessionField.SetValue(sut, _mockSession.Object);

        var connectionField = typeof(ActiveMQSubscribeTopic).GetField("connection", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        connectionField.SetValue(sut, _mockConnection.Object);

        // Act
        sut.Dispose();

        // Assert
        _mockConsumer.Verify(c => c.Close(), Times.Once);
        _mockSession.Verify(s => s.Close(), Times.Once);
        _mockConnection.Verify(c => c.Close(), Times.Once);
    }
}
