using System;
using System.Collections.Generic;
using System.Text.RegularExpressions;
using Xunit;

public enum DatabaseTypes
{
    Oracle,
    SqlServer
}

// ---------- Production Code (copied exactly as provided) ----------
public class CommandQuery
{
    public string CommandString { get; private set; }
    public Dictionary<string, string> Params { get; private set; }

    public CommandQuery(DatabaseTypes dbType, string commandString, params string[] paramValues)
    {
        List<string> parameters = new List<string>();
        string pattern = null;

        switch (dbType)
        {
            case DatabaseTypes.Oracle:
                pattern = @"(?<1>\w):\w+";
                break;

            case DatabaseTypes.SqlServer:
                pattern = @"@\w+";
                break;
        }

        var regexOptions = RegexOptions.None;
        var timeout = TimeSpan.FromSeconds(2);
        var matches = Regex.Matches(commandString, pattern, regexOptions, timeout);

        if (matches != null && matches.Count > 0)
        {
            foreach (Match match in matches)
                parameters.Add(match.Value);
        }

        Initialize(dbType, commandString, parameters, new List<string>(paramValues));
    }

    public CommandQuery(DatabaseTypes dbType, string commandString, List<string> parameters, List<string> parameterValues)
    {
        Initialize(dbType, commandString, parameters, parameterValues);
    }

    public CommandQuery(DatabaseTypes dbType, string commandString, Dictionary<string, string> paramsAndValues)
    {
        Params = paramsAndValues;
        Initialize(dbType, commandString);
    }

    private void Initialize(DatabaseTypes dbType, string commandString, List<string> parameters, List<string> parameterValues)
    {
        if (parameters.Count != parameterValues.Count)
            throw new Exception($"Unable to sync Parameters to ParameterValues for query '{commandString}'");

        Params = new Dictionary<string, string>();
        for (int i = 0; i < parameters.Count; i++)
            Params[parameters[i]] = parameterValues[i];

        Initialize(dbType, commandString);
    }

    private void Initialize(DatabaseTypes dbType, string commandString)
    {
        switch (dbType)
        {
            case DatabaseTypes.Oracle:
                CommandString = commandString.Replace('@', ':');
                break;

            case DatabaseTypes.SqlServer:
                CommandString = commandString.Replace(':', '@');
                break;
        }
    }
}
