// ---------------------------------------------------------------
//  PARSE EXPORT MESSAGE (private static parseExportMessage)
// ---------------------------------------------------------------
[Fact]
public void ParseExportMessage_ValidXml_ReturnsObject()
{
    var xml =
        "<Export>" +
            "<ReferenceId>ABC123</ReferenceId>" +
            "<Code>OK</Code>" +
            "<Message>Success</Message>" +
        "</Export>";

    var method = typeof(ImportMessageQueueClient)
        .GetMethod("parseExportMessage", BindingFlags.NonPublic | BindingFlags.Static);

    Assert.NotNull(method);

    var result = method.Invoke(null, new object[] { xml, null });

    Assert.NotNull(result);

    // Use reflection to check returned object's properties
    var refProp = result.GetType().GetProperty("ReferenceId");
    Assert.Equal("ABC123", refProp.GetValue(result));
}

// ---------------------------------------------------------------
//  BASE64 DECODE TO BYTE (private static base64DecodeToByte)
// ---------------------------------------------------------------
[Fact]
public void Base64DecodeToByte_ReturnsBytes()
{
    var text = "hello world";
    var encoded = Convert.ToBase64String(Encoding.UTF8.GetBytes(text));

    var method = typeof(ImportMessageQueueClient)
        .GetMethod("base64DecodeToByte", BindingFlags.NonPublic | BindingFlags.Static);

    var bytes = (byte[])method.Invoke(null, new object[] { encoded });

    Assert.Equal(text, Encoding.UTF8.GetString(bytes));
}

// ---------------------------------------------------------------
//  SEND MESSAGE FOR DELETE (private sendMessageForDelete)
// ---------------------------------------------------------------
[Fact]
public void SendMessageForDelete_CreatesProperXml()
{
    var client = new ImportMessageQueueClient("http://dummy");

    var method = client.GetType().GetMethod("sendMessageForDelete",
        BindingFlags.NonPublic | BindingFlags.Instance);

    var xml = (string)method.Invoke(client, new object[] { "ABC123", "CASE", "SUB1" });

    Assert.Contains("<DeleteMessage", xml);
    Assert.Contains("ABC123", xml);
    Assert.Contains("CASE", xml);
    Assert.Contains("SUB1", xml);
}

