export const handleArrestBookingConfiguration = (
  stateInfo: any,
  sectionType: any,
  action: any,
  propertyKey?: string
) => {
  try {
    const arrestSectionType =
      getSessionStorageFor(
        HxgnMFRStorageConstants.frCurrentReportSection
      )?.storekey;

    const currentSectionType = sectionType ?? arrestSectionType;

    const currentState = stateInfo[currentSectionType] || {};
    const payloadState = action.payload?.[currentSectionType] || {};

    // ✅ Merge instead of replace (prevents data loss)
    const updatedSection = {
      ...currentState,
      ...payloadState,
    };

    /* ---------------- BOOKING DISABLE LOGIC ---------------- */

    if (isBookingDisabled(action)) {
      const bookingSections = [
        'arrestMedical',
        'arrestBooking',
        'arrestRelease',
        'arrestTransport',
        'arrestNameAtTimeOf',
      ];

      if (
        action.payload?.[currentSectionType] &&
        bookingSections.includes(currentSectionType)
      ) {
        updatedSection[RequestKeyConstant.isBookingDisabled] = true;
      }
    } else if (updatedSection) {
      updatedSection[RequestKeyConstant.isBookingDisabled] = false;
    }

    /* ---------------- BOOKING BUTTON DISABLE ---------------- */

    if (isBookingDisabled(action, true)) {
      updatedSection[RequestKeyConstant.isBookingButtonDisabled] = true;
    }

    /* ---------------- BOOKING STATUS ---------------- */

    if (currentSectionType === RequestKeyConstant.arrestBooking) {
      updatedSection[RequestKeyConstant.bookingStatus] =
        stateInfo[currentSectionType]?.[RequestKeyConstant.active] ||
        updatedSection[RequestKeyConstant.bookingStatus] ===
          RequestKeyConstant.activeBooking
          ? RequestKeyConstant.activeBooking
          : RequestKeyConstant.preBooking;

      // ❗ Logic preserved
      processBooking(action, stateInfo, currentSectionType);
    }

    /* ---------------- BOOKING DETAILS DISABLE ---------------- */

    setBookingDetailsDisabled(
      action,
      HxgnMFRStorageConstants.frSingleSection
    );

    /* ---------------- JUVENILE LOGIC (DOB) ---------------- */

    if (propertyKey === RequestKeyConstant.dob) {
      const selectedDate =
        updatedSection?.[RequestKeyConstant.mfrArresteeNames]?.[
          RequestKeyConstant.dob
        ];

      const juvenileAge = action.extraPayload;
      const arrestDate = updatedSection?.arrestDate;

      if (selectedDate && arrestDate) {
        const personAge = moment(arrestDate).diff(
          moment(selectedDate),
          'years'
        );

        updatedSection[RequestKeyConstant.mfrArresteeNames] = {
          ...updatedSection[RequestKeyConstant.mfrArresteeNames],
          [RequestKeyConstant.afrJuvenile]:
            personAge < juvenileAge,
        };
      }
    }

    /* ---------------- FINAL SAFE RETURN ---------------- */

    return {
      ...stateInfo,
      [currentSectionType]: updatedSection,
    };
  } catch (err) {
    console.error(
      'Error occured while executing method: handleArrestBookingConfiguration',
      err
    );
    return stateInfo;
  }
};
