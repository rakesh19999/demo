it("applies filtering logic when isMyqueryField is true", async () => {
  jest.spyOn(require("react-redux"), "useSelector")
    .mockImplementationOnce((selector) =>
      selector({
        metaDataState: {
          queriesSearchCriteria: {
            agency: { recnum: "123" },
          },
        },
      })
    );

  const mockHandleCustomOptionsSelect = jest.fn(() => [
    { name: "A" },
    { name: "B" },
  ]);

  const mockGetSelectOptions = jest.fn((name) => name === "A");

  await render(
    renderComponent({
      isMyqueryField: true,
      id: "not-reportstatus",
      handleCustomOptionsSelect: mockHandleCustomOptionsSelect,
      getSelectOptions: mockGetSelectOptions,
    })
  );

  expect(mockHandleCustomOptionsSelect).toHaveBeenCalled();
  expect(mockGetSelectOptions).toHaveBeenCalledWith("A");
  expect(mockGetSelectOptions).toHaveBeenCalledWith("B");
});
