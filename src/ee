it("should set filtered options when isMyqueryField is true", () => {
  jest.spyOn(require("react-redux"), "useSelector")
    .mockImplementationOnce((selector) =>
      selector({
        metaDataState: {
          queriesSearchCriteria: {
            agency: { recnum: "123" },
          },
        },
      })
    );

  const mockOptions = [
    { name: "A" },
    { name: "B" },
  ];

  const mockSetOptions = jest.fn();

  render(
    <YourComponent
      handleCustomOptionsSelect={() => mockOptions}
      getSelectOptions={(name) => name === "A"}
      setoptions={mockSetOptions}
      id="not-reportstatus"
      isMyqueryField={true}
    />
  );

  expect(mockSetOptions).toHaveBeenCalledWith([{ name: "A" }]);
});
