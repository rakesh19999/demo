using Xunit;
using Moq;
using System;
using System.Data;
using Newtonsoft.Json;
using OnCall.MFRSessionNotificationsModule;
using Intergraph.Cad.Infrastructure;
using OnCall.SharedWeb.Database;

namespace OnCall.MFRSessionNotificationsModule.Tests
{
    public class AddonLoginUtilTests
    {
        private readonly Mock<ILogger> _loggerMock;
        private readonly Mock<IDatabaseConnectionFactory> _dbFactoryMock;
        private readonly Mock<IParameterRepository> _parameterRepoMock;

        private readonly AddonLoginUtil _sut;

        public AddonLoginUtilTests()
        {
            _loggerMock = new Mock<ILogger>();
            _dbFactoryMock = new Mock<IDatabaseConnectionFactory>();
            _parameterRepoMock = new Mock<IParameterRepository>();

            _sut = new AddonLoginUtil(
                _loggerMock.Object,
                _dbFactoryMock.Object,
                _parameterRepoMock.Object
            );
        }

        #region getEmployeeCustomQuery

        [Fact]
        public void getEmployeeCustomQuery_ReplacesEmployeeRecnum()
        {
            // Arrange
            string employeeRecnum = "12345";
            frLoginAddinConstants.employeeQuery =
                "select * from employee where recnum = ()";

            // Act
            var result = _sut.getEmployeeCustomQuery(employeeRecnum);

            // Assert
            Assert.NotNull(result);
            Assert.Contains(employeeRecnum, result);
            Assert.DoesNotContain("()", result);
        }

        #endregion

        #region getEmployeeImageFromResponse

        [Fact]
        public void getEmployeeImageFromResponse_ReturnsImageThumbnail()
        {
            // Arrange
            string jsonResponse = @"
            {
                ""results"": [
                    {
                        ""RecordAndImage Thumbnail"": {
                            ""Image Thumbnail"": ""base64-image-data""
                        }
                    }
                ]
            }";

            // Act
            var result = _sut.getEmployeeImageFromResponse(jsonResponse);

            // Assert
            Assert.Equal("base64-image-data", result);
        }

        [Fact]
        public void getEmployeeImageFromResponse_WhenResultsEmpty_ReturnsEmptyString()
        {
            // Arrange
            string jsonResponse = @"{ ""results"": [] }";

            // Act
            var result = _sut.getEmployeeImageFromResponse(jsonResponse);

            // Assert
            Assert.Equal(string.Empty, result);
        }

        #endregion

        #region GetUserName

        [Fact]
        public void GetUserName_WhenEmployeeExists_ReturnsUserName()
        {
            // Arrange
            var connectionMock = new Mock<IDbConnection>();
            var commandMock = new Mock<IDbCommand>();
            var readerMock = new Mock<IDataReader>();
            var parameterMock = new Mock<IDbDataParameter>();

            _dbFactoryMock
                .Setup(x => x.CreateRawConnection())
                .Returns(connectionMock.Object);

            connectionMock
                .Setup(x => x.CreateCommand())
                .Returns(commandMock.Object);

            commandMock
                .Setup(x => x.CreateParameter())
                .Returns(parameterMock.Object);

            commandMock
                .Setup(x => x.ExecuteReader())
                .Returns(readerMock.Object);

            readerMock
                .SetupSequence(r => r.Read())
                .Returns(true)
                .Returns(false);

            readerMock
                .Setup(r => r.IsDBNull(0))
                .Returns(false);

            readerMock
                .Setup(r => r.GetString(0))
                .Returns("JohnDoe");

            // Act
            var result = _sut.GetUserName(1001);

            // Assert
            Assert.Equal("JohnDoe", result);
        }

        [Fact]
        public void GetUserName_WhenEmployeeNotFound_ReturnsEmptyString()
        {
            // Arrange
            var connectionMock = new Mock<IDbConnection>();
            var commandMock = new Mock<IDbCommand>();
            var readerMock = new Mock<IDataReader>();
            var parameterMock = new Mock<IDbDataParameter>();

            _dbFactoryMock
                .Setup(x => x.CreateRawConnection())
                .Returns(connectionMock.Object);

            connectionMock
                .Setup(x => x.CreateCommand())
                .Returns(commandMock.Object);

            commandMock
                .Setup(x => x.CreateParameter())
                .Returns(parameterMock.Object);

            commandMock
                .Setup(x => x.ExecuteReader())
                .Returns(readerMock.Object);

            readerMock
                .Setup(r => r.Read())
                .Returns(false);

            // Act
            var result = _sut.GetUserName(2002);

            // Assert
            Assert.Null(result);
        }

        [Fact]
        public void GetUserName_WhenExceptionThrown_ReturnsNullAndLogsError()
        {
            // Arrange
            _dbFactoryMock
                .Setup(x => x.CreateRawConnection())
                .Throws(new Exception("Database failure"));

            // Act
            var result = _sut.GetUserName(3003);

            // Assert
            Assert.Null(result);

            _loggerMock.Verify(
                x => x.Critical(
                    It.Is<string>(s => s.Contains("GetUserName")),
                    It.IsAny<Exception>()),
                Times.Once);
        }

        #endregion
    }
}
