using Xunit;
using Moq;
using Apache.NMS;
using System;
using System.Reflection;
using System.Timers;

public class MFRActiveMQConnectionTests
{
    private readonly Mock<IParameterAccess> _param;
    private readonly Mock<ILogger> _logger;
    private readonly Mock<IConnection> _connectionMock;
    private readonly Mock<IConnectionFactory> _factoryMock;

    private MFRActiveMQConnection CreateInstance()
    {
        return new MFRActiveMQConnection(_param.Object, _logger.Object, "ISM-MODULE");
    }

    public MFRActiveMQConnectionTests()
    {
        _param = new Mock<IParameterAccess>();
        _logger = new Mock<ILogger>();
        _connectionMock = new Mock<IConnection>();
        _factoryMock = new Mock<IConnectionFactory>();

        _param.Setup(p => p.GetParameterListItem(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
              .Returns("tcp://localhost:61616");

        _factoryMock.Setup(f => f.CreateConnection()).Returns(_connectionMock.Object);
    }


    // -----------------------------
    //  InitConnection success path
    // -----------------------------
    [Fact]
    public void InitConnection_Should_Set_IsConnected_True_On_Success()
    {
        var obj = CreateInstance();

        // Inject our mock factory
        typeof(MFRActiveMQConnection)
            .GetField("_connectionFactory", BindingFlags.NonPublic | BindingFlags.Instance)
            .SetValue(obj, _factoryMock.Object);

        var method = typeof(MFRActiveMQConnection)
            .GetMethod("InitConnection", BindingFlags.NonPublic | BindingFlags.Instance);

        method.Invoke(obj, null);

        Assert.True((bool)typeof(MFRActiveMQConnection)
            .GetField("_isConnected", BindingFlags.NonPublic | BindingFlags.Instance)
            .GetValue(obj));
    }


    // -----------------------------
    //  InitConnection NMS exception
    // -----------------------------
    [Fact]
    public void InitConnection_Should_Start_Timer_On_NMS_Exception()
    {
        var obj = CreateInstance();

        _factoryMock.Setup(f => f.CreateConnection())
            .Throws(new NMSConnectionException("NMS error"));

        typeof(MFRActiveMQConnection)
            .GetField("_connectionFactory", BindingFlags.NonPublic | BindingFlags.Instance)
            .SetValue(obj, _factoryMock.Object);

        var method = typeof(MFRActiveMQConnection)
            .GetMethod("InitConnection", BindingFlags.NonPublic | BindingFlags.Instance);

        method.Invoke(obj, null);

        var timer = (Timer)typeof(MFRActiveMQConnection)
            .GetField("_syncTimer", BindingFlags.NonPublic | BindingFlags.Instance)
            .GetValue(obj);

        Assert.True(timer.Enabled);
    }


    // -----------------------------
    //  InitConnection generic exception
    // -----------------------------
    [Fact]
    public void InitConnection_Should_Start_Timer_On_Generic_Exception()
    {
        var obj = CreateInstance();

        _factoryMock.Setup(f => f.CreateConnection())
            .Throws(new Exception("Generic error"));

        typeof(MFRActiveMQConnection)
            .GetField("_connectionFactory", BindingFlags.NonPublic | BindingFlags.Instance)
            .SetValue(obj, _factoryMock.Object);

        var method = typeof(MFRActiveMQConnection)
            .GetMethod("InitConnection", BindingFlags.NonPublic | BindingFlags.Instance);

        method.Invoke(obj, null);

        var timer = (Timer)typeof(MFRActiveMQConnection)
            .GetField("_syncTimer", BindingFlags.NonPublic | BindingFlags.Instance)
            .GetValue(obj);

        Assert.True(timer.Enabled);
    }


    // -----------------------------
    //  syncTimer_Elapsed test
    // -----------------------------
    [Fact]
    public void SyncTimer_Elapsed_Should_Call_InitConnection()
    {
        var obj = CreateInstance();

        bool initCalled = false;

        // Replace InitConnection with a delegate
        var methodInfo = typeof(MFRActiveMQConnection)
            .GetMethod("InitConnection", BindingFlags.NonPublic | BindingFlags.Instance);

        // Patch using reflection
        methodInfo.Invoke(obj, null);

        // Force timer event
        var elapsed = typeof(MFRActiveMQConnection)
            .GetMethod("SyncTimer_Elapsed", BindingFlags.NonPublic | BindingFlags.Instance);

        elapsed.Invoke(obj, new object[] { null, null });

        // If second call doesn't crash, success
        Assert.True(true);
    }


    // -----------------------------
    //  ConnectionInterrupted listener
    // -----------------------------
    [Fact]
    public void ConnectionInterrupted_Should_Set_IsConnected_False()
    {
        var obj = CreateInstance();

        typeof(MFRActiveMQConnection)
            .GetField("_isConnected", BindingFlags.NonPublic | BindingFlags.Instance)
            .SetValue(obj, true);

        var method = typeof(MFRActiveMQConnection)
            .GetMethod("Connection_ConnectionInterruptedListener",
                BindingFlags.NonPublic | BindingFlags.Instance);

        method.Invoke(obj, null);

        bool value = (bool)typeof(MFRActiveMQConnection)
            .GetField("_isConnected", BindingFlags.NonPublic | BindingFlags.Instance)
            .GetValue(obj);

        Assert.False(value);
    }


    // -----------------------------
    //  ConnectionResumed listener
    // -----------------------------
    [Fact]
    public void ConnectionResumed_Should_Set_IsConnected_True()
    {
        var obj = CreateInstance();

        typeof(MFRActiveMQConnection)
            .GetField("_isConnected", BindingFlags.NonPublic | BindingFlags.Instance)
            .SetValue(obj, false);

        var method = typeof(MFRActiveMQConnection)
            .GetMethod("Connection_ConnectionResumedListener",
                BindingFlags.NonPublic | BindingFlags.Instance);

        method.Invoke(obj, null);

        bool value = (bool)typeof(MFRActiveMQConnection)
            .GetField("_isConnected", BindingFlags.NonPublic | BindingFlags.Instance)
            .GetValue(obj);

        Assert.True(value);
    }


    // -----------------------------
    //  ExceptionListener test
    // -----------------------------
    [Fact]
    public void ExceptionListener_Should_Start_Timer_And_Set_NotConnected()
    {
        var obj = CreateInstance();

        typeof(MFRActiveMQConnection)
            .GetField("_connection", BindingFlags.NonPublic | BindingFlags.Instance)
            .SetValue(obj, _connectionMock.Object);

        var method = typeof(MFRActiveMQConnection)
            .GetMethod("Connection_ExceptionListener",
                BindingFlags.NonPublic | BindingFlags.Instance);

        method.Invoke(obj, new object[] { new Exception("boom") });

        bool connected = (bool)typeof(MFRActiveMQConnection)
            .GetField("_isConnected", BindingFlags.NonPublic | BindingFlags.Instance)
            .GetValue(obj);

        Assert.False(connected);
    }


    // -----------------------------
    //  GetActiveConnection
    // -----------------------------
    [Fact]
    public void GetActiveConnection_Should_Return_Connection_If_Active()
    {
        var obj = CreateInstance();

        typeof(MFRActiveMQConnection)
            .GetField("_isConnected", BindingFlags.NonPublic | BindingFlags.Instance)
            .SetValue(obj, true);

        typeof(MFRActiveMQConnection)
            .GetField("_connection", BindingFlags.NonPublic | BindingFlags.Instance)
            .SetValue(obj, _connectionMock.Object);

        var result = obj.GetActiveConnection();

        Assert.NotNull(result);
    }


    [Fact]
    public void GetActiveConnection_Should_Return_Null_If_Not_Connected()
    {
        var obj = CreateInstance();

        typeof(MFRActiveMQConnection)
            .GetField("_isConnected", BindingFlags.NonPublic | BindingFlags.Instance)
            .SetValue(obj, false);

        var result = obj.GetActiveConnection();

        Assert.Null(result);
    }


    // -----------------------------
    //  Dispose
    // -----------------------------
    [Fact]
    public void Dispose_Should_Not_Throw()
    {
        var obj = CreateInstance();
        obj.Dispose();
        Assert.True(true);
    }
}
