import React from "react";
import { render, screen, fireEvent } from "@testing-library/react";
import HxgnMFRMenuComponent from "./HxgnMFRMenuComponent";

describe("Discard confirmation flow", () => {

  function setup(extraProps = {}) {
    const mockOnClose = jest.fn();

    const props = {
      onClose: mockOnClose,
      isDisableDiscardButton: false,
      disabled: false,
      validationDataList: [],
      isConnected: false,
      shouldDisplayRecordLock: false,
      pageCount: 1,
      warningCount: 0,
      validationCount: 0,
      setoffset: jest.fn(),
      offset: 0,
      editDeleteButtonLabel: "Edit",
      recnumOfCurrentRecord: "123",
      onEditReleaseButtonClick: jest.fn(),
      onLockRecordClick: jest.fn(),
      onSecurityButtonClick: jest.fn(),
      onshareclick: jest.fn(),
      handlePrintClick: jest.fn(),
      handlePageClick: jest.fn(),
      warningData: [],
      errorData: [],
      dispatch: jest.fn(),
      ...extraProps
    };

    render(<HxgnMFRMenuComponent {...props} />);
    return { mockOnClose };
  }

  test("opens confirm dialog when discard option is clicked", () => {
    setup();

    // Click the Discard option in dropdown
    const discardOption = screen.getByTestId("mfr-discard"); // adjust if needed
    fireEvent.click(discardOption);

    // Confirm dialog should be visible
    expect(screen.getByText("DISCARD_TEXT")).toBeInTheDocument();
  });

  test("clicking CANCEL closes dialog and does not call onClose", () => {
    const { mockOnClose } = setup();

    // open popup
    fireEvent.click(screen.getByTestId("mfr-discard"));

    // click CANCEL in the dialog
    const cancelBtn = screen.getByTestId("mfr-discard-cancel");
    fireEvent.click(cancelBtn);

    expect(mockOnClose).not.toHaveBeenCalled();
  });

  test("clicking DISCARD in dialog calls onClose(true)", () => {
    const { mockOnClose } = setup();

    // open popup
    fireEvent.click(screen.getByTestId("mfr-discard"));

    // click confirm discard
    const confirmBtn = screen.getByTestId("mfr-discard-confirm");
    fireEvent.click(confirmBtn);

    expect(mockOnClose).toHaveBeenCalledWith(true);
  });
});
