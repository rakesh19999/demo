using System;
using System.IO;
using System.Linq;
using System.Reflection;
using Xunit;
using Moq;
using Intergraph.MFR.ApprovalsCommandModule;
using Intergraph.Framework.Contracts;
using Intergraph.Framework.Logging;
using Intergraph.Framework.Localization;

public class MergeChunksRequestHandlerTests
{
    private readonly Mock<ILogger> _logger = new();
    private readonly Mock<ILocalizedStrings> _localized = new();
    private readonly Mock<ISession> _session = new();
    private readonly Mock<IParameterAccess> _parameterAccess = new();

    private MergeChunksRequestHandler CreateHandler()
    {
        return new MergeChunksRequestHandler(
            _logger.Object,
            _localized.Object,
            _session.Object,
            _parameterAccess.Object
        );
    }

    private MethodInfo GetPrivateMethod(Type type, string methodName)
    {
        var method = type.GetMethod(methodName, BindingFlags.Instance | BindingFlags.NonPublic);
        Assert.NotNull(method);
        return method!;
    }

    [Fact(DisplayName = "HandleMessage_SuccessFlow_ShouldReturnSuccessResponse")]
    public void HandleMessage_SuccessFlow_ShouldReturnSuccessResponse()
    {
        // Arrange
        var handler = CreateHandler();

        // Set up fake parameter paths
        _parameterAccess.Setup(p => p.GetParameterListItem("MFR", "Repository", "MfrChunkRepositoryLocation"))
                        .Returns(Path.GetTempPath());
        _parameterAccess.Setup(p => p.GetParameterListItem("MFR", "Repository", "MfrUploadMergeChunkPath"))
                        .Returns(Path.GetTempPath());

        // Prepare chunk directory with fake files
        string chunkDir = Path.Combine(Path.GetTempPath(), "chunks_" + Guid.NewGuid());
        Directory.CreateDirectory(chunkDir);
        File.WriteAllBytes(Path.Combine(chunkDir, "1"), new byte[] { 1 });
        File.WriteAllBytes(Path.Combine(chunkDir, "2"), new byte[] { 2 });

        // Prepare dummy request
        var request = new MFRCreateMergeChunkRequest
        {
            MergeChunkDetails = new MergeChunkDetails
            {
                AttachmentGuid = Guid.NewGuid().ToString(),
                AttachmentName = "MergedFile",
                FileExtension = ".dat"
            }
        };

        var header = new MessageHeader();

        // Act
        var response = handler.HandleMessage(header, request);

        // Assert
        Assert.NotNull(response);
        Assert.True(response.Response.Success);
        Assert.IsType<MFRCreateMergeChunkResponse>(response.Message);

        // Validate merged file created
        string expectedMergedFile = Path.Combine(Path.GetTempPath(), request.MergeChunkDetails.AttachmentName + request.MergeChunkDetails.FileExtension);
        Assert.True(File.Exists(expectedMergedFile));

        // Clean up
        if (Directory.Exists(chunkDir)) Directory.Delete(chunkDir, true);
        if (File.Exists(expectedMergedFile)) File.Delete(expectedMergedFile);
    }

    [Fact(DisplayName = "HandleMessage_Exception_ShouldReturnFailureResponse")]
    public void HandleMessage_Exception_ShouldReturnFailureResponse()
    {
        // Arrange
        var handler = CreateHandler();

        // Force exception by invalid repository path
        _parameterAccess.Setup(p => p.GetParameterListItem("MFR", "Repository", "MfrChunkRepositoryLocation"))
                        .Throws(new Exception("Invalid parameter"));

        var header = new MessageHeader();
        var request = new MFRCreateMergeChunkRequest
        {
            MergeChunkDetails = new MergeChunkDetails
            {
                AttachmentGuid = Guid.NewGuid().ToString(),
                AttachmentName = "InvalidFile",
                FileExtension = ".txt"
            }
        };

        // Act
        var response = handler.HandleMessage(header, request);

        // Assert
        Assert.NotNull(response);
        Assert.True(response.Response.Success); // method sets Success = true even on exception
        Assert.Contains("Invalid parameter", response.Response.Messages.First());
    }

    [Fact(DisplayName = "InsertAttachmentMergeProgress_ShouldHandleAllStatuses")]
    public void InsertAttachmentMergeProgress_ShouldHandleAllStatuses()
    {
        var handler = CreateHandler();
        var handlerType = handler.GetType();

        // Use reflection to call private InsertAttachmentMergeProgress
        var insertMethod = GetPrivateMethod(handlerType, "InsertAttachmentMergeProgess");

        // Build dummy request
        var request = new MFRCreateMergeChunkRequest
        {
            MergeChunkDetails = new MergeChunkDetails
            {
                AttachmentGuid = Guid.NewGuid().ToString(),
                AttachmentName = "Attach",
                FileExtension = ".dat"
            }
        };

        // Test Pending, Success, Failed, and default
        string[] statuses = { "Pending", "Success", "Failed", "Unknown" };

        foreach (var status in statuses)
        {
            insertMethod.Invoke(handler, new object[] { request, status });
        }

        // If no exception thrown — method covered all cases
        Assert.True(true);
    }

    [Fact(DisplayName = "MergeChunksIntoAttachment_ShouldReturnFalse_OnError")]
    public void MergeChunksIntoAttachment_ShouldReturnFalse_OnError()
    {
        var handler = CreateHandler();
        var handlerType = handler.GetType();
        var mergeMethod = GetPrivateMethod(handlerType, "MergeChunksIntoAttachment");

        // Pass a non-existing directory to cause exception
        string invalidChunkDir = Path.Combine(Path.GetTempPath(), "no_dir_" + Guid.NewGuid());
        string uploadPath = Path.Combine(Path.GetTempPath(), "upload_" + Guid.NewGuid());
        Directory.CreateDirectory(uploadPath);

        var result = (bool)mergeMethod.Invoke(handler, new object[] { invalidChunkDir, uploadPath, "file", ".dat" });

        Assert.False(result);
        Directory.Delete(uploadPath, true);
    }

    [Fact(DisplayName = "DeleteChunks_ShouldDeleteDirectory")]
    public void DeleteChunks_ShouldDeleteDirectory()
    {
        var handler = CreateHandler();
        var handlerType = handler.GetType();
        var deleteMethod = GetPrivateMethod(handlerType, "DeleteChunks");

        string tempDir = Path.Combine(Path.GetTempPath(), "chunks_del_" + Guid.NewGuid());
        Directory.CreateDirectory(tempDir);
        File.WriteAllText(Path.Combine(tempDir, "a.txt"), "test");

        Assert.True(Directory.Exists(tempDir));
        deleteMethod.Invoke(handler, new object[] { tempDir });
        Assert.False(Directory.Exists(tempDir));
    }
}
