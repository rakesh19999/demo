using System;
using System.Collections.Generic;
using System.Diagnostics;
using AutoFixture;
using Intergraph.MFR.ApprovalsModule;
using Intergraph.Cad.Infrastructure;
using Intergraph.Cad.Messaging;
using Moq;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using Xunit;

namespace Intergraph.MFR.Tests
{
    public class SecuredRecordGroupsRequestHandlerTests
    {
        private readonly Mock<ILogger> _mockLogger;
        private readonly Mock<ILocalizedStrings> _mockLocalizedStrings;
        private readonly Mock<IParameterAccess> _mockParameterAccess;
        private readonly Mock<IWebRestServiceManager> _mockWebRestService;
        private readonly Fixture _fixture;

        private readonly MFRSecuredRecordGroupsRequest _validRequest;
        private readonly SecuredRecordGroupsRequestHandler _handler;

        public SecuredRecordGroupsRequestHandlerTests()
        {
            _mockLogger = new Mock<ILogger>();
            _mockLocalizedStrings = new Mock<ILocalizedStrings>();
            _mockParameterAccess = new Mock<IParameterAccess>();
            _mockWebRestService = new Mock<IWebRestServiceManager>();
            _fixture = new Fixture();

            _validRequest = new MFRSecuredRecordGroupsRequest
            {
                Userid = "user123",
                Recnum = "1",
                TableName = "MyTable",
                GroupsRecnums = "2,3",
                RequestType = "add"
            };

            // Create handler with dependency injection
            _handler = new SecuredRecordGroupsRequestHandler(_mockLogger.Object, _mockLocalizedStrings.Object, _mockParameterAccess.Object);
        }

        [Fact]
        public void HandleMessage_Should_ReturnSuccess_ForAddRequest()
        {
            // Arrange
            var responseJson = "{\"recordSecurityGroups\": [{\"GroupId\": 1, \"GroupName\": \"Admin\"}]}";

            // Simulate API response for "add" request
            var mockRestService = new Mock<IWebRestServiceManager>();
            mockRestService
                .Setup(x => x.AddRemoveGroupsToSecuredRecord(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
                .Returns(responseJson);

            // Inject mock rest service dynamically
            var header = new MessageHeader { SessionId = Guid.NewGuid().ToString() };

            // Act
            var result = _handler.HandleMessage(header, _validRequest);

            // Assert
            var messageBody = (MFRSecuredRecordGroupsResponse)result.MessageBody;
            Assert.NotNull(messageBody);
            Assert.True(result.Response.Success);
        }

        [Fact]
        public void HandleMessage_Should_ReturnSuccess_ForGetRequest()
        {
            // Arrange
            var responseJson = "{\"recordSecurityGroups\": [{\"GroupId\": 2, \"GroupName\": \"User\"}]}";

            var request = new MFRSecuredRecordGroupsRequest
            {
                Userid = "user456",
                Recnum = "5",
                TableName = "EmployeeTable",
                GroupsRecnums = "",
                RequestType = "get"
            };

            var header = new MessageHeader { SessionId = Guid.NewGuid().ToString() };

            // Act
            var result = _handler.HandleMessage(header, request);

            // Assert
            var messageBody = (MFRSecuredRecordGroupsResponse)result.MessageBody;
            Assert.NotNull(messageBody);
            Assert.True(result.Response.Success);
        }

        [Fact]
        public void HandleMessage_Should_Handle_EmptyResponse_Gracefully()
        {
            // Arrange
            var request = new MFRSecuredRecordGroupsRequest
            {
                Userid = "user789",
                Recnum = "3",
                TableName = "EmptyTable",
                GroupsRecnums = "",
                RequestType = "get"
            };

            var header = new MessageHeader { SessionId = Guid.NewGuid().ToString() };

            // Act
            var result = _handler.HandleMessage(header, request);

            // Assert
            Assert.NotNull(result);
            Assert.False(result.Response.Success == false); // Should handle gracefully
        }

        [Fact]
        public void HandleMessage_Should_ReturnFailure_On_Exception()
        {
            // Arrange
            var request = new MFRSecuredRecordGroupsRequest
            {
                Userid = "userError",
                Recnum = "99",
                TableName = "FaultyTable",
                GroupsRecnums = "1,2",
                RequestType = "remove"
            };

            var header = new MessageHeader { SessionId = Guid.NewGuid().ToString() };

            // Simulate exception via mock setup
            var mockService = new Mock<IWebRestServiceManager>();
            mockService
                .Setup(x => x.AddRemoveGroupsToSecuredRecord(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>()))
                .Throws(new InvalidOperationException("Test exception"));

            // Act
            var result = _handler.HandleMessage(header, request);

            // Assert
            Assert.NotNull(result);
            Assert.False(result.Response.Success);
            Assert.Contains("Failed to get the Security Groups", result.Response.Messages[0]);
        }

        [Fact]
        public void HandleMessage_Should_Log_ElapsedTime_And_Succeed()
        {
            // Arrange
            var responseJson = "{\"recordSecurityGroups\": [{\"GroupId\": 3, \"GroupName\": \"QA\"}]}";

            var request = new MFRSecuredRecordGroupsRequest
            {
                Userid = "qaUser",
                Recnum = "10",
                TableName = "Quality",
                GroupsRecnums = "5",
                RequestType = "add"
            };

            var header = new MessageHeader { SessionId = Guid.NewGuid().ToString() };

            // Act
            var result = _handler.HandleMessage(header, request);

            // Assert
            Assert.NotNull(result);
            Assert.True(result.Response.Success);
            _mockLogger.Verify(l => l.Info(It.IsAny<string>()), Times.AtLeastOnce);
        }
    }
}
